{
	"$schema": "https://json.schemastore.org/prettierrc",
	"plugins": ["prettier-plugin-astro"],
	"useTabs": true,
	"tabWidth": 2,
	"printWidth": 100,
	"semi": true,
	"singleQuote": false,
	"trailingComma": "all",
	"overrides": [
		{
			"files": "*.astro",
			"options": { "parser": "astro" }
		}
	]
}
