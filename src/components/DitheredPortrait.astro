---
interface Props {
	size?: number;
}

const { size = 280 } = Astro.props;
const pad = 40;
const total = size + pad * 2;
---

<div class="dithered-portrait" style={`width: ${total}px; height: ${total}px; margin: -${pad}px;`}>
	<canvas id="portrait-canvas"></canvas>
	<input type="file" accept="image/*" id="portrait-file" hidden />
</div>

<style>
	.dithered-portrait {
		flex-shrink: 0;
	}
	#portrait-canvas {
		width: 100%;
		height: 100%;
		display: block;
	}
</style>

<script type="module">
	const SPACING = 1.5;
	const DOT = 1.2;
	const GAMMA = 0.45;
	const SAT_BOOST = 1.25;
	const BRIGHTNESS_LIFT = 1.2;
	const SWIRL_AMP = 3.5;
	const SWIRL_SPEED = 0.25;
	const POND_RADIUS = 80;
	const POND_STRENGTH = 45;
	const POND_SPRING = 0.12;
	const POND_DECAY = 0.86;
	const CORNER_RADIUS = 32;
	const RIPPLE_SPEED = 0.3;
	const RIPPLE_WIDTH = 45;
	const RIPPLE_STRENGTH = 32;
	const RIPPLE_LIFE = 3500; // ms

	const BAYER = [
		[0, 32, 8, 40, 2, 34, 10, 42],
		[48, 16, 56, 24, 50, 18, 58, 26],
		[12, 44, 4, 36, 14, 46, 6, 38],
		[60, 28, 52, 20, 62, 30, 54, 22],
		[3, 35, 11, 43, 1, 33, 9, 41],
		[51, 19, 59, 27, 49, 17, 57, 25],
		[15, 47, 7, 39, 13, 45, 5, 37],
		[63, 31, 55, 23, 61, 29, 53, 21],
	].map((r) => r.map((v) => v / 64));

	const canvas = document.getElementById("portrait-canvas");
	const ctx = canvas.getContext("2d");
	const wrap = canvas.parentElement;
	const fileInput = document.getElementById("portrait-file");

	let allDots = [];
	let dotSize = 2;
	let padPx = 0;
	let cursorPx = -9999;
	let cursorPy = -9999;
	let hovering = false;
	let active = false;
	let startMs = 0;
	let ripples = [];
	let t = 0;

	function loadImg(src) {
		return new Promise((res, rej) => {
			const img = new Image();
			img.crossOrigin = "anonymous";
			img.onload = () => res(img);
			img.onerror = rej;
			img.src = src;
		});
	}

	function samplePixels(img, size) {
		const c = document.createElement("canvas");
		c.width = size;
		c.height = size;
		const x = c.getContext("2d");
		const scale = Math.max(size / img.width, size / img.height);
		const w = img.width * scale;
		const h = img.height * scale;
		x.drawImage(img, (size - w) / 2, (size - h) / 2, w, h);
		return x.getImageData(0, 0, size, size).data;
	}

	function boostColor(r, g, b) {
		r = Math.min(255, r * BRIGHTNESS_LIFT);
		g = Math.min(255, g * BRIGHTNESS_LIFT);
		b = Math.min(255, b * BRIGHTNESS_LIFT);
		const avg = (r + g + b) / 3;
		return [
			Math.min(255, Math.max(0, Math.round(avg + (r - avg) * SAT_BOOST))),
			Math.min(255, Math.max(0, Math.round(avg + (g - avg) * SAT_BOOST))),
			Math.min(255, Math.max(0, Math.round(avg + (b - avg) * SAT_BOOST))),
		];
	}

	// Check if a point is inside the rounded rect (for masking dots to shape)
	function inRoundedRect(x, y, pad, imgSize, radius) {
		const lx = x - pad;
		const ly = y - pad;
		if (lx < 0 || ly < 0 || lx >= imgSize || ly >= imgSize) return false;
		// Check corners
		if (lx < radius && ly < radius) {
			const dx = radius - lx, dy = radius - ly;
			return dx * dx + dy * dy <= radius * radius;
		}
		if (lx > imgSize - radius && ly < radius) {
			const dx = lx - (imgSize - radius), dy = radius - ly;
			return dx * dx + dy * dy <= radius * radius;
		}
		if (lx < radius && ly > imgSize - radius) {
			const dx = radius - lx, dy = ly - (imgSize - radius);
			return dx * dx + dy * dy <= radius * radius;
		}
		if (lx > imgSize - radius && ly > imgSize - radius) {
			const dx = lx - (imgSize - radius), dy = ly - (imgSize - radius);
			return dx * dx + dy * dy <= radius * radius;
		}
		return true;
	}

	function buildDots(img, imgSize, dpr) {
		const px = samplePixels(img, imgSize);
		const spacing = Math.round(SPACING * dpr);
		dotSize = Math.round(DOT * dpr);
		const radius = Math.round(CORNER_RADIUS * dpr);
		const dots = [];

		for (let y = 0; y < imgSize; y += spacing) {
			for (let x = 0; x < imgSize; x += spacing) {
				const i = (y * imgSize + x) * 4;
				if (px[i + 3] < 128) continue;

				if (!inRoundedRect(x + padPx, y + padPx, padPx, imgSize, radius)) continue;

				const lum =
					(0.299 * px[i] + 0.587 * px[i + 1] + 0.114 * px[i + 2]) / 255;
				const brightness = Math.pow(lum, GAMMA);

				const bx = Math.floor(x / spacing) % 8;
				const by = Math.floor(y / spacing) % 8;
				// Bright areas (face): almost no dithering. Dark areas (edges): heavy dithering.
				const threshold = BAYER[by][bx] * (1 - brightness * 0.9);
				if (brightness <= threshold) continue;

				const [r, g, b] = boostColor(px[i], px[i + 1], px[i + 2]);
				const alpha = 0.55 + brightness * 0.45;
				// Distance from center: 0 at middle, 1 at corner
				const dx = (x - imgSize / 2) / (imgSize / 2);
				const dy = (y - imgSize / 2) / (imgSize / 2);
				const dist = Math.min(1, Math.sqrt(dx * dx + dy * dy));
				// No swirl in center, ramps up at edges
				const swirlDist = Math.max(0, dist - 0.4) / 0.6; // starts at 40% from center
				const swirlScale = 0.05 + swirlDist * swirlDist * 2.5;

				dots.push({
					x: x + padPx,
					y: y + padPx,
					color: `rgba(${r},${g},${b},${alpha})`,
					swirlScale,
					ox: 0,
					oy: 0,
					phase: Math.random() * Math.PI * 2,
				});
			}
		}

		return dots;
	}

	function render() {
		if (!active) return;

		const now = performance.now();
		const w = canvas.width;
		const h = canvas.height;
		const dpr = Math.min(window.devicePixelRatio || 1, 2);
		const pondR = POND_RADIUS * dpr;
		const pondS = POND_STRENGTH * dpr;
		const ripW = RIPPLE_WIDTH * dpr;
		const ripS = RIPPLE_STRENGTH * dpr;

		const age = (now - startMs) / 1000;
		const fadeIn = Math.min(1, age / 0.8);
		t += SWIRL_SPEED * 0.016; // ~60fps normalized
		const swirlA = SWIRL_AMP * dpr;

		// Prune dead ripples
		ripples = ripples.filter((r) => now - r.t < RIPPLE_LIFE);

		ctx.clearRect(0, 0, w, h);
		ctx.globalAlpha = fadeIn;

		let prevColor = "";

		for (let i = 0; i < allDots.length; i++) {
			const dot = allDots[i];

			// Pond repulsion
			const ddx = dot.x + dot.ox - cursorPx;
			const ddy = dot.y + dot.oy - cursorPy;

			let targetOx = 0;
			let targetOy = 0;

			if (hovering && Math.abs(ddx) < pondR && Math.abs(ddy) < pondR) {
				const dist = Math.sqrt(ddx * ddx + ddy * ddy);
				if (dist < pondR && dist > 0.1) {
					const force = ((1 - dist / pondR) ** 2) * pondS;
					targetOx = (ddx / dist) * force;
					targetOy = (ddy / dist) * force;
				}
			}

			// Ripple forces
			for (let ri = 0; ri < ripples.length; ri++) {
				const rip = ripples[ri];
				const elapsed = now - rip.t;
				const ripRadius = elapsed * RIPPLE_SPEED * dpr;
				const fade = 1 - elapsed / RIPPLE_LIFE;

				const rx = dot.x - rip.x;
				const ry = dot.y - rip.y;
				const dist = Math.sqrt(rx * rx + ry * ry);

				const diff = Math.abs(dist - ripRadius);
				if (diff < ripW && dist > 0.1) {
					const intensity = (1 - diff / ripW) * fade * ripS;
					targetOx += (rx / dist) * intensity;
					targetOy += (ry / dist) * intensity;
				}
			}

			dot.ox += (targetOx - dot.ox) * POND_SPRING;
			dot.oy += (targetOy - dot.oy) * POND_SPRING;
			dot.ox *= POND_DECAY;
			dot.oy *= POND_DECAY;

			// Continuous swirl with per-dot randomized phase
			const p = dot.phase;
			const nx = dot.x * 0.006;
			const ny = dot.y * 0.006;
			const angle = Math.sin(nx * 2.3 + t + p) * Math.cos(ny * 1.9 - t * 0.6 + p * 0.7) * Math.PI * 2;
			const swirlMag = swirlA * dot.swirlScale * (0.4 + 0.6 * Math.sin(nx * 1.1 + ny * 1.5 + t * 0.3 + p));
			const sx = Math.cos(angle) * swirlMag;
			const sy = Math.sin(angle) * swirlMag;

			const fx = dot.x + dot.ox + sx;
			const fy = dot.y + dot.oy + sy;

			if (dot.color !== prevColor) {
				ctx.fillStyle = dot.color;
				prevColor = dot.color;
			}
			ctx.fillRect(fx, fy, dotSize, dotSize);
		}

		ctx.globalAlpha = 1;
		requestAnimationFrame(render);
	}

	function process(img) {
		const cssTotalSize = wrap.clientWidth;
		const dpr = Math.min(window.devicePixelRatio || 1, 2);
		const totalSize = Math.round(cssTotalSize * dpr);
		// Compute padding in canvas pixels from the CSS margin
		const style = getComputedStyle(wrap);
		const cssImgSize = cssTotalSize + parseFloat(style.marginLeft) * 2;
		padPx = Math.round(40 * dpr);
		const imgSize = totalSize - padPx * 2;

		canvas.width = totalSize;
		canvas.height = totalSize;

		allDots = buildDots(img, imgSize, dpr);

		active = true;
		startMs = performance.now();
		requestAnimationFrame(render);

		canvas.addEventListener("mousemove", (e) => {
			const r = canvas.getBoundingClientRect();
			cursorPx = ((e.clientX - r.left) / r.width) * canvas.width;
			cursorPy = ((e.clientY - r.top) / r.height) * canvas.height;
			hovering = true;
		});
		canvas.addEventListener("mouseleave", () => {
			hovering = false;
		});
		function haptic() {
			if (navigator.vibrate) navigator.vibrate(8);
		}

		canvas.addEventListener("click", (e) => {
			const r = canvas.getBoundingClientRect();
			ripples.push({
				x: ((e.clientX - r.left) / r.width) * canvas.width,
				y: ((e.clientY - r.top) / r.height) * canvas.height,
				t: performance.now(),
			});
			haptic();
		});

		canvas.addEventListener("touchstart", (e) => {
			const r = canvas.getBoundingClientRect();
			cursorPx = ((e.touches[0].clientX - r.left) / r.width) * canvas.width;
			cursorPy = ((e.touches[0].clientY - r.top) / r.height) * canvas.height;
			hovering = true;
			// Ripple on tap
			ripples.push({ x: cursorPx, y: cursorPy, t: performance.now() });
			haptic();
		}, { passive: true });

		canvas.addEventListener(
			"touchmove",
			(e) => {
				e.preventDefault();
				const r = canvas.getBoundingClientRect();
				cursorPx =
					((e.touches[0].clientX - r.left) / r.width) * canvas.width;
				cursorPy =
					((e.touches[0].clientY - r.top) / r.height) * canvas.height;
				hovering = true;
			},
			{ passive: false },
		);
		canvas.addEventListener("touchend", () => {
			hovering = false;
		});
	}

	fileInput.addEventListener("change", (e) => {
		const file = e.target.files?.[0];
		if (!file) return;
		loadImg(URL.createObjectURL(file)).then(process);
	});

	loadImg("/me.jpg")
		.then(process)
		.catch(() => {
			wrap.addEventListener("click", () => fileInput.click(), { once: true });
		});
</script>
