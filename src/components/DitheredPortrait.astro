---
interface Props {
	size?: number;
}

const { size = 280 } = Astro.props;
const pad = 40;
const total = size + pad * 2;
---

<div class="shrink-0" style={`width: ${total}px; height: ${total}px; margin: -${pad}px;`}>
	<canvas id="portrait-canvas" class="w-full h-full block"></canvas>
	<input type="file" accept="image/*" id="portrait-file" hidden />
</div>

<script type="module">
	// === Halftone parameters ===
	// Every non-transparent cell gets a dot; size lives in [MIN, MAX].
	// MIN is the floor for even the brightest source pixels so highlights
	// still carry real color — without a floor, bright cells drop out and
	// the card bg leaks through, washing the whole image toward gray.
	const SPACING = 2.1; // grid pitch in CSS px
	const MAX_RADIUS = 1.25; // shadow dots
	const MIN_RADIUS = 0.75; // highlight dots — big enough to show color
	const TONE_CURVE = 0.65; // gamma on inkness signal (within [MIN,MAX])

	// === Color refinement (gentle) ===
	// Light mode uses source-over, not multiply: overlapping dots would
	// compound-darken with multiply, turning mid-tone hair into near-black.
	// With source-over + slight alpha, dots render at ~photo colors and
	// density emerges from dot size alone. Minimal sat bump just adds a
	// touch of screen vibrance to match the camera's saturation.
	const COLOR_SAT_LIGHT = 1.1;
	const COLOR_SAT_DARK = 1.22;
	const COLOR_LIFT_LIGHT = 1.0;
	const COLOR_LIFT_DARK = 1.12;
	const DOT_ALPHA_LIGHT = 0.92;
	const WARM_R = 1.0;
	const WARM_G = 1.0;
	const WARM_B = 1.0;

	// === Physics ===
	const SWIRL_AMP = 3.5;
	const SWIRL_SPEED = 0.25;
	const POND_RADIUS = 80;
	const POND_STRENGTH = 45;
	const POND_SPRING = 0.12;
	const POND_DECAY = 0.86;
	const CORNER_RADIUS = 32;
	const RIPPLE_SPEED = 0.3;
	const RIPPLE_WIDTH = 45;
	const RIPPLE_STRENGTH = 32;
	const RIPPLE_LIFE = 3500;
	const RANDOM_RIPPLE_MIN_GAP = 3200;
	const RANDOM_RIPPLE_MAX_GAP = 7800;
	const TWO_PI = Math.PI * 2;

	// Entry animation: pure staggered fade, inside-out
	const ENTRY_FADE = 0.9;
	const ENTRY_MAX_DELAY = 0.95;

	const canvas = document.getElementById("portrait-canvas");
	const ctx = canvas.getContext("2d");
	const wrap = canvas.parentElement;
	const fileInput = document.getElementById("portrait-file");

	let allDots = [];
	let padPx = 0;
	let cursorPx = -9999;
	let cursorPy = -9999;
	let hovering = false;
	let active = false;
	let startMs = 0;
	let ripples = [];
	let t = 0;
	let nextRandomRippleMs = 0;
	let entryDone = false;
	// Cached for rebuilding dots on theme change without re-decoding.
	let cachedImg = null;
	let cachedImgSize = 0;
	let cachedDpr = 1;
	let cachedPixels = null;

	function scheduleNextRandomRipple(now) {
		return (
			now + RANDOM_RIPPLE_MIN_GAP + Math.random() * (RANDOM_RIPPLE_MAX_GAP - RANDOM_RIPPLE_MIN_GAP)
		);
	}

	function loadImg(src) {
		return new Promise((res, rej) => {
			const img = new Image();
			img.crossOrigin = "anonymous";
			img.onload = () => res(img);
			img.onerror = rej;
			img.src = src;
		});
	}

	function samplePixels(img, size) {
		const c = document.createElement("canvas");
		c.width = size;
		c.height = size;
		const x = c.getContext("2d");
		const scale = Math.max(size / img.width, size / img.height);
		const w = img.width * scale;
		const h = img.height * scale;
		x.drawImage(img, (size - w) / 2, (size - h) / 2, w, h);
		return x.getImageData(0, 0, size, size).data;
	}

	const htmlEl = document.documentElement;
	function isLight() {
		return htmlEl.getAttribute("data-theme") === "light";
	}

	// Light-touch color processing. The halftone itself provides tonal
	// density — brightness comes from dot SIZE, so we don't need to lift
	// or slam saturation the way the threshold-based version did.
	function processColor(r, g, b, light) {
		const lift = light ? COLOR_LIFT_LIGHT : COLOR_LIFT_DARK;
		const sat = light ? COLOR_SAT_LIGHT : COLOR_SAT_DARK;
		r = Math.min(255, r * lift);
		g = Math.min(255, g * lift);
		b = Math.min(255, b * lift);
		const avg = (r + g + b) / 3;
		r = avg + (r - avg) * sat;
		g = avg + (g - avg) * sat;
		b = avg + (b - avg) * sat;
		// Warm shift: lift R, cut B. Pulls skin out of the mauve/cool cast
		// the raw photo + multiply compositing tends toward. R and G stay
		// closer together so we don't swing the image orange.
		r *= WARM_R;
		g *= WARM_G;
		b *= WARM_B;
		return [
			Math.min(255, Math.max(0, Math.round(r))),
			Math.min(255, Math.max(0, Math.round(g))),
			Math.min(255, Math.max(0, Math.round(b))),
		];
	}

	// Check if a point is inside the rounded rect (for masking dots to shape)
	function inRoundedRect(x, y, pad, imgSize, radius) {
		const lx = x - pad;
		const ly = y - pad;
		if (lx < 0 || ly < 0 || lx >= imgSize || ly >= imgSize) return false;
		if (lx < radius && ly < radius) {
			const dx = radius - lx,
				dy = radius - ly;
			return dx * dx + dy * dy <= radius * radius;
		}
		if (lx > imgSize - radius && ly < radius) {
			const dx = lx - (imgSize - radius),
				dy = radius - ly;
			return dx * dx + dy * dy <= radius * radius;
		}
		if (lx < radius && ly > imgSize - radius) {
			const dx = radius - lx,
				dy = ly - (imgSize - radius);
			return dx * dx + dy * dy <= radius * radius;
		}
		if (lx > imgSize - radius && ly > imgSize - radius) {
			const dx = lx - (imgSize - radius),
				dy = ly - (imgSize - radius);
			return dx * dx + dy * dy <= radius * radius;
		}
		return true;
	}

	function buildDots(img, imgSize, dpr) {
		const light = isLight();
		if (!cachedPixels || cachedImgSize !== imgSize) {
			cachedPixels = samplePixels(img, imgSize);
		}
		const px = cachedPixels;
		const spacing = Math.max(1, Math.round(SPACING * dpr));
		const maxR = MAX_RADIUS * dpr;
		const minR = MIN_RADIUS * dpr;
		const cornerR = Math.round(CORNER_RADIUS * dpr);
		const dots = [];

		for (let y = 0; y < imgSize; y += spacing) {
			for (let x = 0; x < imgSize; x += spacing) {
				const i = (y * imgSize + x) * 4;
				if (px[i + 3] < 128) continue;
				if (!inRoundedRect(x + padPx, y + padPx, padPx, imgSize, cornerR)) continue;

				const rawR = px[i];
				const rawG = px[i + 1];
				const rawB = px[i + 2];
				const lum = (0.299 * rawR + 0.587 * rawG + 0.114 * rawB) / 255;

				// Light bg: darkness drives dot size (shadows = big, highlights = small).
				// Dark bg: brightness drives dot size (highlights = big, shadows = small).
				// Radius spans [minR, maxR] — highlights never go to zero,
				// so every cell carries its photo color (no gray gaps).
				const signal = Math.max(0, Math.min(1, light ? 1 - lum : lum));
				const radius = minR + (maxR - minR) * Math.pow(signal, TONE_CURVE);

				const [cr, cg, cb] = processColor(rawR, rawG, rawB, light);
				const dotAlpha = light ? DOT_ALPHA_LIGHT : 1;
				const color = `rgba(${cr},${cg},${cb},${dotAlpha})`;

				const dx = (x - imgSize / 2) / (imgSize / 2);
				const dy = (y - imgSize / 2) / (imgSize / 2);
				const dist = Math.min(1, Math.sqrt(dx * dx + dy * dy));
				const swirlDist = Math.max(0, dist - 0.4) / 0.6;
				const swirlScale = 0.05 + swirlDist * swirlDist * 2.5;

				const posX = x + padPx;
				const posY = y + padPx;
				const phase = Math.random() * TWO_PI;
				const nxv = posX * 0.006;
				const nyv = posY * 0.006;

				const jitterRange = 0.18 + dist * 0.45;
				const entryJitter = (Math.random() - 0.5) * jitterRange;
				const entryDelay = Math.max(0, dist * ENTRY_MAX_DELAY + entryJitter);

				dots.push({
					x: posX,
					y: posY,
					radius,
					color,
					swirlScale,
					ox: 0,
					oy: 0,
					fx: posX,
					fy: posY,
					phase,
					ax: nxv * 2.3,
					ay: nyv * 1.9,
					mx: nxv * 1.1 + nyv * 1.5,
					p7: phase * 0.7,
					entryDelay,
					entryAlpha: 0,
				});
			}
		}

		return dots;
	}

	function render() {
		if (!active) return;

		const now = performance.now();
		const w = canvas.width;
		const h = canvas.height;
		const dpr = Math.min(window.devicePixelRatio || 1, 2);
		const pondR = POND_RADIUS * dpr;
		const pondR2 = pondR * pondR;
		const pondS = POND_STRENGTH * dpr;
		const ripW = RIPPLE_WIDTH * dpr;
		const ripS = RIPPLE_STRENGTH * dpr;

		const age = (now - startMs) / 1000;
		t += SWIRL_SPEED * 0.016;
		const swirlA = SWIRL_AMP * dpr;
		const tSlow = t * 0.6;
		const tMicro = t * 0.3;

		if (!entryDone && age > ENTRY_MAX_DELAY + ENTRY_FADE + 0.2) {
			entryDone = true;
		}
		if (now >= nextRandomRippleMs) {
			ripples.push({
				x: padPx + Math.random() * (w - padPx * 2),
				y: padPx + Math.random() * (h - padPx * 2),
				t: now,
			});
			nextRandomRippleMs = scheduleNextRandomRipple(now);
		}

		if (ripples.length > 0) {
			ripples = ripples.filter((r) => now - r.t < RIPPLE_LIFE);
		}

		const nRipples = ripples.length;
		let ripRadii = null;
		let ripFades = null;
		let ripRadiiMax = null;
		if (nRipples > 0) {
			ripRadii = new Float32Array(nRipples);
			ripFades = new Float32Array(nRipples);
			ripRadiiMax = new Float32Array(nRipples);
			for (let ri = 0; ri < nRipples; ri++) {
				const elapsed = now - ripples[ri].t;
				const rad = elapsed * RIPPLE_SPEED * dpr;
				ripRadii[ri] = rad;
				ripFades[ri] = 1 - elapsed / RIPPLE_LIFE;
				ripRadiiMax[ri] = rad + ripW;
			}
		}

		ctx.clearRect(0, 0, w, h);
		ctx.globalAlpha = 1;

		// PASS 1: physics update + swirl — cache fx/fy per dot
		const N = allDots.length;
		for (let i = 0; i < N; i++) {
			const dot = allDots[i];

			let targetOx = 0;
			let targetOy = 0;
			if (hovering) {
				const ddx = dot.x + dot.ox - cursorPx;
				const ddy = dot.y + dot.oy - cursorPy;
				const adx = ddx < 0 ? -ddx : ddx;
				const ady = ddy < 0 ? -ddy : ddy;
				if (adx < pondR && ady < pondR) {
					const d2 = ddx * ddx + ddy * ddy;
					if (d2 < pondR2 && d2 > 0.01) {
						const dist = Math.sqrt(d2);
						const k = 1 - dist / pondR;
						const force = (k * k * pondS) / dist;
						targetOx = ddx * force;
						targetOy = ddy * force;
					}
				}
			}

			for (let ri = 0; ri < nRipples; ri++) {
				const rip = ripples[ri];
				const rx = dot.x - rip.x;
				const ry = dot.y - rip.y;
				const arx = rx < 0 ? -rx : rx;
				const ary = ry < 0 ? -ry : ry;
				const rMax = ripRadiiMax[ri];
				if (arx > rMax || ary > rMax) continue;
				const d2 = rx * rx + ry * ry;
				const dist = Math.sqrt(d2);
				const rr = ripRadii[ri];
				const diff = dist > rr ? dist - rr : rr - dist;
				if (diff < ripW && dist > 0.1) {
					const intensity = ((1 - diff / ripW) * ripFades[ri] * ripS) / dist;
					targetOx += rx * intensity;
					targetOy += ry * intensity;
				}
			}

			dot.ox += (targetOx - dot.ox) * POND_SPRING;
			dot.oy += (targetOy - dot.oy) * POND_SPRING;
			dot.ox *= POND_DECAY;
			dot.oy *= POND_DECAY;

			if (!entryDone) {
				const rawP = (age - dot.entryDelay) / ENTRY_FADE;
				if (rawP <= 0) {
					dot.entryAlpha = 0;
				} else if (rawP >= 1) {
					dot.entryAlpha = 1;
				} else {
					const inv = 1 - rawP;
					dot.entryAlpha = 1 - inv * inv * inv;
				}
			}

			const p = dot.phase;
			const angle = Math.sin(dot.ax + t + p) * Math.cos(dot.ay - tSlow + dot.p7) * TWO_PI;
			const swirlMag = swirlA * dot.swirlScale * (0.4 + 0.6 * Math.sin(dot.mx + tMicro + p));
			dot.fx = dot.x + dot.ox + Math.cos(angle) * swirlMag;
			dot.fy = dot.y + dot.oy + Math.sin(angle) * swirlMag;
		}

		// PASS 2: halftone dots as circles, varying radius.
		// source-over on light bg: dots render at their own colors without
		// compounding (multiply would darken each overlap, killing hair
		// mid-tones). screen on dark bg: bright dots add light to dark bg.
		ctx.globalCompositeOperation = isLight() ? "source-over" : "screen";
		if (entryDone) {
			ctx.globalAlpha = 1;
			for (let i = 0; i < N; i++) {
				const dot = allDots[i];
				ctx.fillStyle = dot.color;
				ctx.beginPath();
				ctx.arc(dot.fx, dot.fy, dot.radius, 0, TWO_PI);
				ctx.fill();
			}
		} else {
			for (let i = 0; i < N; i++) {
				const dot = allDots[i];
				const a = dot.entryAlpha;
				if (a <= 0.001) continue;
				ctx.globalAlpha = a;
				ctx.fillStyle = dot.color;
				ctx.beginPath();
				ctx.arc(dot.fx, dot.fy, dot.radius, 0, TWO_PI);
				ctx.fill();
			}
		}

		ctx.globalAlpha = 1;
		requestAnimationFrame(render);
	}

	function process(img) {
		const cssTotalSize = wrap.clientWidth;
		const dpr = Math.min(window.devicePixelRatio || 1, 2);
		const totalSize = Math.round(cssTotalSize * dpr);
		const style = getComputedStyle(wrap);
		const cssImgSize = cssTotalSize + parseFloat(style.marginLeft) * 2;
		padPx = Math.round(40 * dpr);
		const imgSize = totalSize - padPx * 2;

		canvas.width = totalSize;
		canvas.height = totalSize;

		cachedImg = img;
		cachedImgSize = imgSize;
		cachedDpr = dpr;
		cachedPixels = null;
		allDots = buildDots(img, imgSize, dpr);
		entryDone = false;

		active = true;
		startMs = performance.now();
		nextRandomRippleMs = scheduleNextRandomRipple(startMs);
		requestAnimationFrame(render);

		if (!process._themeObserverAttached) {
			const themeObserver = new MutationObserver(() => {
				if (!cachedImg) return;
				allDots = buildDots(cachedImg, cachedImgSize, cachedDpr);
				entryDone = true;
				for (let i = 0; i < allDots.length; i++) allDots[i].entryAlpha = 1;
			});
			themeObserver.observe(htmlEl, { attributes: true, attributeFilter: ["data-theme"] });
			process._themeObserverAttached = true;
		}

		canvas.addEventListener("mousemove", (e) => {
			const r = canvas.getBoundingClientRect();
			cursorPx = ((e.clientX - r.left) / r.width) * canvas.width;
			cursorPy = ((e.clientY - r.top) / r.height) * canvas.height;
			hovering = true;
		});
		canvas.addEventListener("mouseleave", () => {
			hovering = false;
		});
		function haptic() {
			if (navigator.vibrate) navigator.vibrate(8);
		}

		canvas.addEventListener("click", (e) => {
			const r = canvas.getBoundingClientRect();
			ripples.push({
				x: ((e.clientX - r.left) / r.width) * canvas.width,
				y: ((e.clientY - r.top) / r.height) * canvas.height,
				t: performance.now(),
			});
			haptic();
		});

		canvas.addEventListener(
			"touchstart",
			(e) => {
				const r = canvas.getBoundingClientRect();
				cursorPx = ((e.touches[0].clientX - r.left) / r.width) * canvas.width;
				cursorPy = ((e.touches[0].clientY - r.top) / r.height) * canvas.height;
				hovering = true;
				ripples.push({
					x: cursorPx,
					y: cursorPy,
					t: performance.now(),
				});
				haptic();
			},
			{ passive: true },
		);

		canvas.addEventListener(
			"touchmove",
			(e) => {
				e.preventDefault();
				const r = canvas.getBoundingClientRect();
				cursorPx = ((e.touches[0].clientX - r.left) / r.width) * canvas.width;
				cursorPy = ((e.touches[0].clientY - r.top) / r.height) * canvas.height;
				hovering = true;
			},
			{ passive: false },
		);
		canvas.addEventListener("touchend", () => {
			hovering = false;
		});
	}

	fileInput.addEventListener("change", (e) => {
		const file = e.target.files?.[0];
		if (!file) return;
		loadImg(URL.createObjectURL(file)).then(process);
	});

	loadImg("/me.jpg")
		.then(process)
		.catch(() => {
			wrap.addEventListener("click", () => fileInput.click(), {
				once: true,
			});
		});
</script>
