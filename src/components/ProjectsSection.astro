---
import { getCollection } from "astro:content";

const projects = (await getCollection("projects", ({ data }) => !data.draft)).sort((a, b) => {
	if (a.data.featured !== b.data.featured) return a.data.featured ? -1 : 1;
	return b.data.date.getTime() - a.data.date.getTime();
});

type Category = "type" | "framework" | "language";

const categories: { key: Category; label: string }[] = [
	{ key: "type", label: "Type" },
	{ key: "framework", label: "Framework" },
	{ key: "language", label: "Language" },
];

const categoryValues = new Map<Category, Map<string, number>>();
for (const { key } of categories) categoryValues.set(key, new Map());
for (const project of projects) {
	for (const { key } of categories) {
		const bucket = categoryValues.get(key);
		if (!bucket) continue;
		for (const value of project.data.tags[key]) {
			bucket.set(value, (bucket.get(value) ?? 0) + 1);
		}
	}
}

function formatDate(date: Date) {
	return date.toLocaleDateString("en-US", { year: "numeric", month: "short" });
}

function serializeTags(tags: (typeof projects)[number]["data"]["tags"]) {
	return [
		...tags.type.map((t) => `type:${t}`),
		...tags.framework.map((f) => `framework:${f}`),
		...tags.language.map((l) => `language:${l}`),
	].join(" ");
}
---

<section id="projects" class="pt-16 pb-20 border-t border-border-subtle">
	<div class="max-w-240 mx-auto px-6">
		<div class="flex items-baseline gap-3 mb-6 fade-in">
			<h2 class="font-display text-[32px] font-normal">Projects</h2>
			<span id="projects-count" class="font-mono text-[13px] text-text-faint"
				>{projects.length}</span
			>
		</div>
		<div
			id="filter-bar"
			class="flex flex-wrap items-center gap-2 mb-7 pb-6 border-b border-border-subtle fade-in"
		>
			{
				categories.map(({ key, label }) => {
					const values = categoryValues.get(key);
					if (!values || values.size === 0) return null;
					const sorted = [...values.entries()].sort((a, b) => b[1] - a[1]);
					return (
						<div class="filter-dropdown" data-cat={key}>
							<button type="button" class="filter-trigger">
								<span>{label}</span>
								<span class="trigger-count" style="display:none;" />
								<svg
									class="chevron"
									width="12"
									height="12"
									viewBox="0 0 24 24"
									fill="none"
									stroke="currentColor"
									stroke-width="2"
									stroke-linecap="round"
									stroke-linejoin="round"
								>
									<path d="M6 9l6 6 6-6" />
								</svg>
							</button>
							<div class="filter-menu">
								{sorted.map(([value, count]) => (
									<button
										type="button"
										class="filter-option"
										data-value={value}
										data-cat={key}
									>
										<span class="check">
											<svg
												width="10"
												height="10"
												viewBox="0 0 24 24"
												fill="none"
												stroke="var(--color-surface)"
												stroke-width="3"
												stroke-linecap="round"
												stroke-linejoin="round"
											>
												<path d="M20 6L9 17l-5-5" />
											</svg>
										</span>
										{key === "language" && <span class="opt-dot" data-lang={value} />}
										<span>{value}</span>
										<span class="opt-count">{count}</span>
									</button>
								))}
							</div>
						</div>
					);
				})
			}
		</div>
		<div id="projects-grid" class="grid grid-cols-3 gap-3 max-md:grid-cols-2 max-sm:grid-cols-1">
			{
				projects.map((project) => {
					const language = project.data.tags.language[0];
					return (
						<a
							href={`/projects/${project.id}`}
							class="card fade-in"
							data-tags={serializeTags(project.data.tags)}
						>
							<div class="card-header">
								<span class="name">{project.data.name}</span>
							</div>
							<p>{project.data.description}</p>
							<div class="card-footer">
								{language && (
									<span class="lang" data-lang={language}>
										<span class="dot" />
										{language}
									</span>
								)}
								{project.data.owner !== "lucasilverentand" && (
									<span class="card-owner">{project.data.owner}</span>
								)}
								<span class="card-updated">{formatDate(project.data.date)}</span>
							</div>
						</a>
					);
				})
			}
		</div>
	</div>
</section>

<style is:global>
	/* All selectors here target dynamically-created elements, so they need
	   to be global rather than scoped. */

	/* Card */
	.card {
		display: flex;
		flex-direction: column;
		background: var(--color-surface-raised);
		border: 1px solid var(--color-border-subtle);
		border-radius: 12px;
		padding: 20px 22px 18px;
		transition:
			border-color 0.2s,
			box-shadow 0.2s,
			transform 0.2s;
		position: relative;
		overflow: hidden;
		color: inherit;
		text-decoration: none;
	}
	.card:hover {
		border-color: var(--color-border-strong);
		transform: translateY(-2px);
		box-shadow: 0 4px 24px rgba(0, 0, 0, 0.12);
	}

	/* Card inner elements */
	.card-header {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 8px;
		margin-bottom: 8px;
	}
	.card .name {
		font-family: var(--font-mono);
		font-size: 14px;
		font-weight: 600;
		color: var(--color-text-primary);
		overflow: hidden;
		text-overflow: ellipsis;
		white-space: nowrap;
	}
	.card p {
		font-size: 13px;
		line-height: 1.6;
		color: var(--color-text-muted);
		flex: 1;
		margin-bottom: 16px;
		display: -webkit-box;
		-webkit-line-clamp: 2;
		-webkit-box-orient: vertical;
		overflow: hidden;
	}
	.card-footer {
		display: flex;
		align-items: center;
		gap: 10px;
	}
	.card .lang {
		display: inline-flex;
		align-items: center;
		gap: 6px;
		font-family: var(--font-mono);
		font-size: 11px;
		color: var(--color-text-faint);
	}
	.card .lang .dot {
		width: 7px;
		height: 7px;
		border-radius: 50%;
		background: var(--c, var(--color-text-faint));
	}
	.card-owner {
		font-family: var(--font-mono);
		font-size: 10px;
		color: var(--color-text-faint);
		background: var(--color-surface-elevated);
		padding: 2px 8px;
		border-radius: 999px;
		margin-left: auto;
	}
	.card-updated {
		font-family: var(--font-mono);
		font-size: 10px;
		color: var(--color-text-faint);
		opacity: 0.6;
		margin-left: auto;
	}
	.card-owner + .card-updated {
		margin-left: 0;
	}
	.card[data-hidden="true"] {
		display: none;
	}

	/* Filter dropdown */
	.filter-dropdown {
		position: relative;
	}
	.filter-trigger {
		display: inline-flex;
		align-items: center;
		gap: 6px;
		font-family: var(--font-mono);
		font-size: 12px;
		color: var(--color-text-faint);
		background: transparent;
		border: 1px solid var(--color-border-subtle);
		border-radius: 8px;
		padding: 6px 12px;
		cursor: pointer;
		transition:
			color 0.15s,
			border-color 0.15s,
			background 0.15s;
		white-space: nowrap;
	}
	.filter-trigger:hover,
	.filter-trigger.open {
		color: var(--color-text-muted);
		border-color: var(--color-border-strong);
		background: var(--color-surface-raised);
	}
	.filter-trigger .chevron {
		transition: transform 0.15s;
	}
	.filter-trigger.open .chevron {
		transform: rotate(180deg);
	}
	.trigger-count {
		font-size: 10px;
		background: var(--color-text-primary);
		color: var(--color-surface);
		border-radius: 999px;
		min-width: 16px;
		height: 16px;
		line-height: 16px;
		text-align: center;
		padding: 0 4px;
	}
	.filter-menu {
		position: absolute;
		top: calc(100% + 4px);
		left: 0;
		min-width: 180px;
		background: var(--color-surface-raised);
		border: 1px solid var(--color-border-strong);
		border-radius: 10px;
		padding: 4px;
		z-index: 50;
		box-shadow: 0 8px 32px rgba(0, 0, 0, 0.24);
		display: none;
	}
	.filter-menu.open {
		display: block;
	}
	.filter-option {
		display: flex;
		align-items: center;
		gap: 8px;
		width: 100%;
		font-family: var(--font-mono);
		font-size: 12px;
		color: var(--color-text-muted);
		background: transparent;
		border: none;
		border-radius: 6px;
		padding: 7px 10px;
		cursor: pointer;
		transition:
			background 0.1s,
			color 0.1s;
		text-align: left;
	}
	.filter-option:hover {
		background: var(--color-surface-elevated);
		color: var(--color-text-primary);
	}
	.filter-option .check {
		width: 14px;
		height: 14px;
		border: 1px solid var(--color-border-strong);
		border-radius: 3px;
		flex-shrink: 0;
		display: flex;
		align-items: center;
		justify-content: center;
		transition:
			background 0.1s,
			border-color 0.1s;
	}
	.filter-option.checked .check {
		background: var(--color-text-primary);
		border-color: var(--color-text-primary);
	}
	.filter-option .check svg {
		display: none;
	}
	.filter-option.checked .check svg {
		display: block;
	}
	.filter-option .opt-dot {
		width: 7px;
		height: 7px;
		border-radius: 50%;
		flex-shrink: 0;
		background: var(--c, var(--color-text-faint));
	}
	.filter-option .opt-count {
		font-size: 11px;
		color: var(--color-text-faint);
		margin-left: auto;
	}

	/* Filter chips */
	.filter-chip {
		display: inline-flex;
		align-items: center;
		gap: 5px;
		font-family: var(--font-mono);
		font-size: 11px;
		color: var(--color-text-primary);
		background: var(--color-surface-elevated);
		border: 1px solid var(--color-border-strong);
		border-radius: 999px;
		padding: 3px 8px 3px 10px;
		cursor: pointer;
		transition:
			background 0.1s,
			border-color 0.1s;
		white-space: nowrap;
	}
	.filter-chip:hover {
		background: var(--color-border-subtle);
	}
	.filter-chip .chip-dot {
		width: 6px;
		height: 6px;
		border-radius: 50%;
		flex-shrink: 0;
	}
	.filter-chip .chip-x {
		color: var(--color-text-faint);
		font-size: 13px;
		line-height: 1;
	}

	@media (max-width: 768px) {
		.filter-trigger {
			font-size: 11px;
			padding: 5px 10px;
		}
	}
</style>

<script>
	const LANG_COLORS: Record<string, string> = {
		swift: "#ff453a",
		rust: "#e05a00",
		typescript: "#3b82f6",
		javascript: "#eab308",
		python: "#4b91f7",
		astro: "#ff5d01",
		shell: "#89e051",
		go: "#00add8",
		ruby: "#cc342d",
		mdx: "#fcb32c",
		yaml: "#cb171e",
		markdown: "#083fa1",
	};

	type Category = "type" | "framework" | "language";

	const activeFilters: Record<Category, Set<string>> = {
		type: new Set(),
		framework: new Set(),
		language: new Set(),
	};

	function applyLangColor(el: HTMLElement) {
		const lang = el.dataset.lang;
		if (lang && LANG_COLORS[lang]) {
			el.style.setProperty("--c", LANG_COLORS[lang]);
		}
	}

	for (const el of document.querySelectorAll<HTMLElement>("[data-lang]")) {
		applyLangColor(el);
	}

	function parseCardTags(card: HTMLElement): Record<Category, Set<string>> {
		const raw = card.dataset.tags ?? "";
		const out: Record<Category, Set<string>> = {
			type: new Set(),
			framework: new Set(),
			language: new Set(),
		};
		for (const token of raw.split(/\s+/)) {
			if (!token) continue;
			const idx = token.indexOf(":");
			if (idx === -1) continue;
			const cat = token.slice(0, idx) as Category;
			const value = token.slice(idx + 1);
			if (out[cat]) out[cat].add(value);
		}
		return out;
	}

	function matches(card: HTMLElement): boolean {
		const tags = parseCardTags(card);
		for (const cat of ["type", "framework", "language"] as Category[]) {
			const active = activeFilters[cat];
			if (active.size === 0) continue;
			let found = false;
			for (const v of active) {
				if (tags[cat].has(v)) {
					found = true;
					break;
				}
			}
			if (!found) return false;
		}
		return true;
	}

	function updateGrid() {
		const cards = document.querySelectorAll<HTMLElement>("#projects-grid .card");
		let visible = 0;
		for (const card of cards) {
			if (matches(card)) {
				card.removeAttribute("data-hidden");
				visible++;
			} else {
				card.setAttribute("data-hidden", "true");
			}
		}
		const countEl = document.getElementById("projects-count");
		if (countEl) countEl.textContent = String(visible);
	}

	function renderChips() {
		const bar = document.getElementById("filter-bar");
		if (!bar) return;
		for (const chip of bar.querySelectorAll(".filter-chip")) chip.remove();

		for (const cat of ["type", "framework", "language"] as Category[]) {
			for (const value of activeFilters[cat]) {
				const chip = document.createElement("button");
				chip.type = "button";
				chip.className = "filter-chip";

				if (cat === "language" && LANG_COLORS[value]) {
					const dot = document.createElement("span");
					dot.className = "chip-dot";
					dot.style.background = LANG_COLORS[value];
					chip.appendChild(dot);
				}

				chip.appendChild(document.createTextNode(value));

				const x = document.createElement("span");
				x.className = "chip-x";
				x.textContent = "\u00d7";
				chip.appendChild(x);

				chip.addEventListener("click", () => {
					activeFilters[cat].delete(value);
					updateDropdownState(cat);
					renderChips();
					updateGrid();
				});

				bar.appendChild(chip);
			}
		}
	}

	function updateDropdownState(cat: Category) {
		const dropdown = document.querySelector(`.filter-dropdown[data-cat="${cat}"]`);
		if (!dropdown) return;
		const trigger = dropdown.querySelector(".filter-trigger");
		const count = activeFilters[cat].size;
		const countBadge = trigger?.querySelector(".trigger-count") as HTMLElement | null;

		if (countBadge) {
			if (count > 0) {
				countBadge.textContent = String(count);
				countBadge.style.display = "";
			} else {
				countBadge.style.display = "none";
			}
		}

		for (const opt of dropdown.querySelectorAll<HTMLElement>(".filter-option")) {
			const val = opt.dataset.value;
			if (val && activeFilters[cat].has(val)) {
				opt.classList.add("checked");
			} else {
				opt.classList.remove("checked");
			}
		}
	}

	let openDropdown: HTMLElement | null = null;

	function closeAllDropdowns() {
		for (const m of document.querySelectorAll(".filter-menu.open")) m.classList.remove("open");
		for (const t of document.querySelectorAll(".filter-trigger.open")) t.classList.remove("open");
		openDropdown = null;
	}

	document.addEventListener("click", (e) => {
		if (openDropdown && !openDropdown.contains(e.target as Node)) {
			closeAllDropdowns();
		}
	});

	for (const dropdown of document.querySelectorAll<HTMLElement>(".filter-dropdown")) {
		const cat = dropdown.dataset.cat as Category | undefined;
		if (!cat) continue;

		const trigger = dropdown.querySelector<HTMLElement>(".filter-trigger");
		const menu = dropdown.querySelector<HTMLElement>(".filter-menu");
		if (!trigger || !menu) continue;

		trigger.addEventListener("click", (e) => {
			e.stopPropagation();
			const isOpen = menu.classList.contains("open");
			closeAllDropdowns();
			if (!isOpen) {
				menu.classList.add("open");
				trigger.classList.add("open");
				openDropdown = dropdown;
			}
		});

		for (const opt of dropdown.querySelectorAll<HTMLElement>(".filter-option")) {
			const value = opt.dataset.value;
			if (!value) continue;
			opt.addEventListener("click", (e) => {
				e.stopPropagation();
				const set = activeFilters[cat];
				if (set.has(value)) {
					set.delete(value);
					opt.classList.remove("checked");
				} else {
					set.add(value);
					opt.classList.add("checked");
				}
				updateDropdownState(cat);
				renderChips();
				updateGrid();
			});
		}
	}
</script>
