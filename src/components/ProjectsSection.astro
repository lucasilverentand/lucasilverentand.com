<section class="pt-16 pb-20 border-t border-border-subtle">
	<div class="max-w-240 mx-auto px-6">
		<div class="flex items-baseline gap-3 mb-6">
			<h2 class="font-display text-[32px] font-normal">Projects</h2>
			<span id="projects-count" class="font-mono text-[13px] text-text-faint"></span>
		</div>
		<div id="filter-bar" class="flex flex-wrap items-center gap-2 mb-7 pb-6 border-b border-border-subtle">
		</div>
		<div id="projects-grid" class="grid grid-cols-3 gap-3 max-md:grid-cols-2 max-sm:grid-cols-1">
		</div>
	</div>
</section>

<style is:global>
	/* All selectors here target dynamically-created elements, so they need
	   to be global rather than scoped. */

	/* Card */
	.card {
		display: flex;
		flex-direction: column;
		background: var(--color-surface-raised);
		border: 1px solid var(--color-border-subtle);
		border-radius: 12px;
		padding: 20px 22px 18px;
		transition:
			border-color 0.2s,
			box-shadow 0.2s,
			transform 0.2s;
		position: relative;
		overflow: hidden;
	}
	.card::before {
		content: "";
		position: absolute;
		top: 0;
		left: 0;
		right: 0;
		height: 2px;
		background: var(--card-accent, var(--color-border-subtle));
		opacity: 0;
		transition: opacity 0.2s;
	}
	.card:hover {
		border-color: var(--color-border-strong);
		transform: translateY(-2px);
		box-shadow: 0 4px 24px rgba(0, 0, 0, 0.12);
	}
	.card:hover::before {
		opacity: 1;
	}

	/* Card inner elements */
	.card-header {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 8px;
		margin-bottom: 8px;
	}
	.card .name {
		font-family: var(--font-mono);
		font-size: 14px;
		font-weight: 600;
		color: var(--color-text-primary);
		overflow: hidden;
		text-overflow: ellipsis;
		white-space: nowrap;
	}
	.card .stars {
		display: flex;
		align-items: center;
		gap: 4px;
		font-family: var(--font-mono);
		font-size: 12px;
		color: var(--color-text-faint);
		flex-shrink: 0;
	}
	.card p {
		font-size: 13px;
		line-height: 1.6;
		color: var(--color-text-muted);
		flex: 1;
		margin-bottom: 16px;
		display: -webkit-box;
		-webkit-line-clamp: 2;
		-webkit-box-orient: vertical;
		overflow: hidden;
	}
	.card-footer {
		display: flex;
		align-items: center;
		gap: 10px;
	}
	.card .lang {
		display: inline-flex;
		align-items: center;
		gap: 6px;
		font-family: var(--font-mono);
		font-size: 11px;
		color: var(--color-text-faint);
	}
	.card .lang .dot {
		width: 7px;
		height: 7px;
		border-radius: 50%;
		background: var(--c);
	}
	.card-owner {
		font-family: var(--font-mono);
		font-size: 10px;
		color: var(--color-text-faint);
		background: var(--color-surface-elevated);
		padding: 2px 8px;
		border-radius: 999px;
		margin-left: auto;
	}
	.card-updated {
		font-family: var(--font-mono);
		font-size: 10px;
		color: var(--color-text-faint);
		opacity: 0.6;
		margin-left: auto;
	}
	.card-owner + .card-updated {
		margin-left: 0;
	}

	/* Filter dropdown */
	.filter-dropdown {
		position: relative;
	}
	.filter-trigger {
		display: inline-flex;
		align-items: center;
		gap: 6px;
		font-family: var(--font-mono);
		font-size: 12px;
		color: var(--color-text-faint);
		background: transparent;
		border: 1px solid var(--color-border-subtle);
		border-radius: 8px;
		padding: 6px 12px;
		cursor: pointer;
		transition:
			color 0.15s,
			border-color 0.15s,
			background 0.15s;
		white-space: nowrap;
	}
	.filter-trigger:hover,
	.filter-trigger.open {
		color: var(--color-text-muted);
		border-color: var(--color-border-strong);
		background: var(--color-surface-raised);
	}
	.filter-trigger .chevron {
		transition: transform 0.15s;
	}
	.filter-trigger.open .chevron {
		transform: rotate(180deg);
	}
	.filter-menu {
		position: absolute;
		top: calc(100% + 4px);
		left: 0;
		min-width: 180px;
		background: var(--color-surface-raised);
		border: 1px solid var(--color-border-strong);
		border-radius: 10px;
		padding: 4px;
		z-index: 50;
		box-shadow: 0 8px 32px rgba(0, 0, 0, 0.24);
		display: none;
	}
	.filter-menu.open {
		display: block;
	}
	.filter-option {
		display: flex;
		align-items: center;
		gap: 8px;
		width: 100%;
		font-family: var(--font-mono);
		font-size: 12px;
		color: var(--color-text-muted);
		background: transparent;
		border: none;
		border-radius: 6px;
		padding: 7px 10px;
		cursor: pointer;
		transition:
			background 0.1s,
			color 0.1s;
		text-align: left;
	}
	.filter-option:hover {
		background: var(--color-surface-elevated);
		color: var(--color-text-primary);
	}
	.filter-option .check {
		width: 14px;
		height: 14px;
		border: 1px solid var(--color-border-strong);
		border-radius: 3px;
		flex-shrink: 0;
		display: flex;
		align-items: center;
		justify-content: center;
		transition:
			background 0.1s,
			border-color 0.1s;
	}
	.filter-option.checked .check {
		background: var(--color-text-primary);
		border-color: var(--color-text-primary);
	}
	.filter-option .check svg {
		display: none;
	}
	.filter-option.checked .check svg {
		display: block;
	}
	.filter-option .opt-dot {
		width: 7px;
		height: 7px;
		border-radius: 50%;
		flex-shrink: 0;
	}
	.filter-option .opt-count {
		font-size: 11px;
		color: var(--color-text-faint);
		margin-left: auto;
	}

	/* Filter chips */
	.filter-chip {
		display: inline-flex;
		align-items: center;
		gap: 5px;
		font-family: var(--font-mono);
		font-size: 11px;
		color: var(--color-text-primary);
		background: var(--color-surface-elevated);
		border: 1px solid var(--color-border-strong);
		border-radius: 999px;
		padding: 3px 8px 3px 10px;
		cursor: pointer;
		transition:
			background 0.1s,
			border-color 0.1s;
		white-space: nowrap;
	}
	.filter-chip:hover {
		background: var(--color-border-subtle);
	}
	.filter-chip .chip-dot {
		width: 6px;
		height: 6px;
		border-radius: 50%;
		flex-shrink: 0;
	}
	.filter-chip .chip-x {
		color: var(--color-text-faint);
		font-size: 13px;
		line-height: 1;
	}

	@media (max-width: 768px) {
		.filter-trigger {
			font-size: 11px;
			padding: 5px 10px;
		}
	}
</style>

<script>
	const LANG_COLORS: Record<string, string> = {
		swift: "#ff453a",
		rust: "#e05a00",
		typescript: "#3b82f6",
		javascript: "#eab308",
		python: "#4b91f7",
		astro: "#ff5d01",
		shell: "#89e051",
		go: "#00add8",
		ruby: "#cc342d",
		mdx: "#fcb32c",
		yaml: "#cb171e",
		markdown: "#083fa1",
	};

	interface Tags {
		type: string[];
		framework: string[];
		language: string[];
	}

	interface Project {
		name: string;
		description: string | null;
		owner: string;
		url: string | null;
		homepage: string | null;
		language: string | null;
		stars: number;
		topics: string[];
		updated_at: string | null;
		source: "github" | "published-app";
		platform?: string;
		app_store_url?: string;
		tags?: Tags;
	}

	const PROJECTS_URL =
		"https://raw.githubusercontent.com/lucasilverentand/lucasilverentand/main/projects.json";

	type Category = "type" | "framework" | "language";

	let allProjects: Project[] = [];
	const activeFilters: Record<Category, Set<string>> = {
		type: new Set(),
		framework: new Set(),
		language: new Set(),
	};

	function timeAgo(dateStr: string): string {
		const seconds = Math.floor((Date.now() - new Date(dateStr).getTime()) / 1000);
		const intervals: [number, string][] = [
			[31536000, "y"],
			[2592000, "mo"],
			[604800, "w"],
			[86400, "d"],
			[3600, "h"],
		];
		for (const [secs, label] of intervals) {
			const count = Math.floor(seconds / secs);
			if (count >= 1) return `${count}${label} ago`;
		}
		return "just now";
	}

	function getTags(p: Project): Tags {
		if (p.tags) return p.tags;
		return {
			type: [],
			framework: [],
			language: p.language ? [p.language.toLowerCase()] : [],
		};
	}

	function matchesFilters(p: Project): boolean {
		const tags = getTags(p);
		const matchType =
			activeFilters.type.size === 0 || tags.type.some((t) => activeFilters.type.has(t));
		const matchFramework =
			activeFilters.framework.size === 0 ||
			tags.framework.some((f) => activeFilters.framework.has(f));
		const matchLanguage =
			activeFilters.language.size === 0 || tags.language.some((l) => activeFilters.language.has(l));
		return matchType && matchFramework && matchLanguage;
	}

	function createStarSvg(): SVGSVGElement {
		const svg = document.createElementNS("http://www.w3.org/2000/svg", "svg");
		svg.setAttribute("width", "12");
		svg.setAttribute("height", "12");
		svg.setAttribute("viewBox", "0 0 24 24");
		svg.setAttribute("fill", "currentColor");
		const path = document.createElementNS("http://www.w3.org/2000/svg", "path");
		path.setAttribute(
			"d",
			"M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z",
		);
		svg.appendChild(path);
		return svg;
	}

	function createCard(p: Project, index: number): HTMLAnchorElement {
		const tags = getTags(p);
		const card = document.createElement("a");
		card.href = p.url ?? p.homepage ?? p.app_store_url ?? "#";
		card.target = "_blank";
		card.rel = "noopener";
		card.className = "card fade-in";
		card.style.transitionDelay = `${Math.min(index, 11) * 0.02}s`;

		const lang = tags.language[0];
		const accent = lang ? (LANG_COLORS[lang] ?? "var(--color-border-strong)") : "var(--color-border-strong)";
		card.style.setProperty("--card-accent", accent);

		const header = document.createElement("div");
		header.className = "card-header";
		const name = document.createElement("span");
		name.className = "name";
		name.textContent = p.name;
		header.appendChild(name);

		if (p.stars > 0) {
			const stars = document.createElement("span");
			stars.className = "stars";
			stars.appendChild(createStarSvg());
			stars.appendChild(document.createTextNode(String(p.stars)));
			header.appendChild(stars);
		}

		card.appendChild(header);

		const desc = document.createElement("p");
		desc.textContent = p.description ?? "";
		card.appendChild(desc);

		const footer = document.createElement("div");
		footer.className = "card-footer";

		if (lang) {
			const langEl = document.createElement("span");
			langEl.className = "lang";
			langEl.style.setProperty("--c", LANG_COLORS[lang] ?? "var(--color-text-faint)");
			const dot = document.createElement("span");
			dot.className = "dot";
			langEl.appendChild(dot);
			langEl.appendChild(document.createTextNode(lang));
			footer.appendChild(langEl);
		}

		if (p.owner !== "lucasilverentand") {
			const owner = document.createElement("span");
			owner.className = "card-owner";
			owner.textContent = p.owner;
			footer.appendChild(owner);
		}

		if (p.updated_at) {
			const updated = document.createElement("span");
			updated.className = "card-updated";
			updated.textContent = timeAgo(p.updated_at);
			footer.appendChild(updated);
		}

		card.appendChild(footer);
		return card;
	}

	function createCheckSvg(): SVGSVGElement {
		const svg = document.createElementNS("http://www.w3.org/2000/svg", "svg");
		svg.setAttribute("width", "10");
		svg.setAttribute("height", "10");
		svg.setAttribute("viewBox", "0 0 24 24");
		svg.setAttribute("fill", "none");
		svg.setAttribute("stroke", "var(--color-surface)");
		svg.setAttribute("stroke-width", "3");
		svg.setAttribute("stroke-linecap", "round");
		svg.setAttribute("stroke-linejoin", "round");
		const path = document.createElementNS("http://www.w3.org/2000/svg", "path");
		path.setAttribute("d", "M20 6L9 17l-5-5");
		svg.appendChild(path);
		return svg;
	}

	function createChevronSvg(): SVGSVGElement {
		const svg = document.createElementNS("http://www.w3.org/2000/svg", "svg");
		svg.setAttribute("width", "12");
		svg.setAttribute("height", "12");
		svg.setAttribute("viewBox", "0 0 24 24");
		svg.setAttribute("fill", "none");
		svg.setAttribute("stroke", "currentColor");
		svg.setAttribute("stroke-width", "2");
		svg.setAttribute("stroke-linecap", "round");
		svg.setAttribute("stroke-linejoin", "round");
		svg.classList.add("chevron");
		const path = document.createElementNS("http://www.w3.org/2000/svg", "path");
		path.setAttribute("d", "M6 9l6 6 6-6");
		svg.appendChild(path);
		return svg;
	}

	let openDropdown: HTMLElement | null = null;

	function closeAllDropdowns() {
		document.querySelectorAll(".filter-menu.open").forEach((m) => m.classList.remove("open"));
		document.querySelectorAll(".filter-trigger.open").forEach((t) => t.classList.remove("open"));
		openDropdown = null;
	}

	document.addEventListener("click", (e) => {
		if (openDropdown && !openDropdown.contains(e.target as Node)) {
			closeAllDropdowns();
		}
	});

	function renderChips() {
		const bar = document.getElementById("filter-bar");
		if (!bar) return;
		bar.querySelectorAll(".filter-chip").forEach((c) => c.remove());

		for (const cat of ["type", "framework", "language"] as Category[]) {
			for (const value of activeFilters[cat]) {
				const chip = document.createElement("button");
				chip.type = "button";
				chip.className = "filter-chip";

				if (cat === "language" && LANG_COLORS[value]) {
					const dot = document.createElement("span");
					dot.className = "chip-dot";
					dot.style.background = LANG_COLORS[value];
					chip.appendChild(dot);
				}

				chip.appendChild(document.createTextNode(value));

				const x = document.createElement("span");
				x.className = "chip-x";
				x.textContent = "\u00d7";
				chip.appendChild(x);

				chip.addEventListener("click", () => {
					activeFilters[cat].delete(value);
					updateDropdownState(cat);
					renderChips();
					renderGrid();
				});

				bar.appendChild(chip);
			}
		}
	}

	function updateDropdownState(cat: Category) {
		const dropdown = document.querySelector(`.filter-dropdown[data-cat="${cat}"]`);
		if (!dropdown) return;
		const trigger = dropdown.querySelector(".filter-trigger");
		const count = activeFilters[cat].size;
		const countBadge = trigger?.querySelector(".trigger-count") as HTMLElement | null;

		if (countBadge) {
			if (count > 0) {
				countBadge.textContent = String(count);
				countBadge.style.display = "";
			} else {
				countBadge.style.display = "none";
			}
		}

		dropdown.querySelectorAll<HTMLButtonElement>(".filter-option").forEach((opt) => {
			const val = opt.dataset.value!;
			if (activeFilters[cat].has(val)) {
				opt.classList.add("checked");
			} else {
				opt.classList.remove("checked");
			}
		});
	}

	function buildFilterBar(projects: Project[]) {
		const bar = document.getElementById("filter-bar");
		if (!bar) return;

		const categories: { key: Category; label: string }[] = [
			{ key: "type", label: "Type" },
			{ key: "framework", label: "Framework" },
			{ key: "language", label: "Language" },
		];

		for (const cat of categories) {
			const counts = new Map<string, number>();
			for (const p of projects) {
				const tags = getTags(p);
				for (const val of tags[cat.key]) {
					counts.set(val, (counts.get(val) ?? 0) + 1);
				}
			}

			if (counts.size === 0) continue;

			const sorted = [...counts.entries()].sort((a, b) => b[1] - a[1]);

			const dropdown = document.createElement("div");
			dropdown.className = "filter-dropdown";
			dropdown.dataset.cat = cat.key;

			const trigger = document.createElement("button");
			trigger.type = "button";
			trigger.className = "filter-trigger";
			trigger.appendChild(document.createTextNode(cat.label));

			const countBadge = document.createElement("span");
			countBadge.className = "trigger-count";
			countBadge.style.cssText =
				"display:none; font-size:10px; background:var(--color-text-primary); color:var(--color-surface); border-radius:999px; min-width:16px; height:16px; line-height:16px; text-align:center; padding:0 4px;";
			trigger.appendChild(countBadge);

			trigger.appendChild(createChevronSvg());
			dropdown.appendChild(trigger);

			const menu = document.createElement("div");
			menu.className = "filter-menu";

			for (const [value, count] of sorted) {
				const opt = document.createElement("button");
				opt.type = "button";
				opt.className = "filter-option";
				opt.dataset.value = value;

				const check = document.createElement("span");
				check.className = "check";
				check.appendChild(createCheckSvg());
				opt.appendChild(check);

				if (cat.key === "language" && LANG_COLORS[value]) {
					const dot = document.createElement("span");
					dot.className = "opt-dot";
					dot.style.background = LANG_COLORS[value];
					opt.appendChild(dot);
				}

				opt.appendChild(document.createTextNode(value));

				const countEl = document.createElement("span");
				countEl.className = "opt-count";
				countEl.textContent = String(count);
				opt.appendChild(countEl);

				opt.addEventListener("click", (e) => {
					e.stopPropagation();
					const set = activeFilters[cat.key];
					if (set.has(value)) {
						set.delete(value);
						opt.classList.remove("checked");
					} else {
						set.add(value);
						opt.classList.add("checked");
					}
					updateDropdownState(cat.key);
					renderChips();
					renderGrid();
				});

				menu.appendChild(opt);
			}

			dropdown.appendChild(menu);

			trigger.addEventListener("click", (e) => {
				e.stopPropagation();
				const isOpen = menu.classList.contains("open");
				closeAllDropdowns();
				if (!isOpen) {
					menu.classList.add("open");
					trigger.classList.add("open");
					openDropdown = dropdown;
				}
			});

			bar.appendChild(dropdown);
		}
	}

	let isAnimating = false;

	function renderGrid(animate = true) {
		const grid = document.getElementById("projects-grid");
		const countEl = document.getElementById("projects-count");
		if (!grid) return;

		const filtered = allProjects.filter(matchesFilters);
		if (countEl) countEl.textContent = `${filtered.length}`;
		renderChips();

		const existingCards = grid.querySelectorAll<HTMLElement>(".card");

		if (!animate || existingCards.length === 0 || isAnimating) {
			grid.replaceChildren();
			const fadeObserver = (window as unknown as { __fadeInObserver?: IntersectionObserver })
				.__fadeInObserver;
			for (let i = 0; i < filtered.length; i++) {
				const card = createCard(filtered[i], i);
				grid.appendChild(card);
				fadeObserver?.observe(card);
			}
			return;
		}

		isAnimating = true;

		for (const card of existingCards) {
			card.classList.add("fade-out");
			card.classList.remove("visible");
		}

		setTimeout(() => {
			grid.replaceChildren();

			for (let i = 0; i < filtered.length; i++) {
				const card = createCard(filtered[i], i);
				card.classList.remove("fade-in");
				card.style.opacity = "0";
				card.style.filter = "blur(4px)";
				card.style.transform = "scale(0.97)";
				card.style.transition = "none";
				grid.appendChild(card);
			}

			requestAnimationFrame(() => {
				requestAnimationFrame(() => {
					const cards = grid.querySelectorAll<HTMLElement>(".card");
					for (let i = 0; i < cards.length; i++) {
						const card = cards[i];
						const delay = Math.min(i, 11) * 0.03;
						card.style.transition = `opacity 0.35s cubic-bezier(0.16, 1, 0.3, 1) ${delay}s, filter 0.35s cubic-bezier(0.16, 1, 0.3, 1) ${delay}s, transform 0.35s cubic-bezier(0.16, 1, 0.3, 1) ${delay}s`;
						card.style.opacity = "1";
						card.style.filter = "blur(0)";
						card.style.transform = "scale(1)";
					}
					setTimeout(() => {
						const done = grid.querySelectorAll<HTMLElement>(".card");
						for (const c of done) {
							c.style.opacity = "";
							c.style.filter = "";
							c.style.transform = "";
							c.style.transition = "";
						}
						isAnimating = false;
					}, 400);
				});
			});
		}, 200);
	}

	async function loadProjects() {
		const grid = document.getElementById("projects-grid");
		if (!grid) return;

		try {
			const res = await fetch(PROJECTS_URL);
			const data: { projects: Project[] } = await res.json();

			allProjects = data.projects
				.filter((p) => p.name !== "lucasilverentand" && !p.name.startsWith("."))
				.sort((a, b) => {
					const da = a.updated_at ? new Date(a.updated_at).getTime() : 0;
					const db = b.updated_at ? new Date(b.updated_at).getTime() : 0;
					return db - da;
				});

			buildFilterBar(allProjects);
			renderGrid(false);
		} catch {
			const msg = document.createElement("p");
			msg.style.color = "var(--color-text-faint)";
			msg.style.fontSize = "14px";
			msg.textContent = "Failed to load projects.";
			grid.appendChild(msg);
		}
	}

	loadProjects();
</script>
