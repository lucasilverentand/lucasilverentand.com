---
interface Props {
	source: string;
}

const { source } = Astro.props;

const normalizedSource = source.trim().toLowerCase();

const sourceConfig = {
	medium: {
		label: "Medium",
	},
	substack: {
		label: "Substack",
	},
}[normalizedSource] ?? {
	label: source,
};
---

<span
	class="source-badge inline-flex items-center justify-center text-text-3 leading-none shrink-0 h-3.5 align-middle opacity-40"
	data-source={normalizedSource}
	aria-label={sourceConfig.label}
	title={sourceConfig.label}
>
	{
		normalizedSource === "medium" ? (
			<img
				src="/medium-wordmark-white.svg"
				alt=""
				width="70"
				height="14"
				aria-hidden="true"
				class="block h-full w-auto"
			/>
		) : normalizedSource === "substack" ? (
			<img
				src="/substack-wordmark-white.svg"
				alt=""
				width="72"
				height="12"
				aria-hidden="true"
				class="block h-full w-auto"
			/>
		) : (
			<span class="size-[7px] rounded-full bg-text-1 shrink-0" aria-hidden="true" />
		)
	}
</span>

<style>
	/* Light-mode: invert the white wordmark SVGs so they read on a light bg. */
	:global([data-theme="light"]) .source-badge img[src*="wordmark-white"] {
		filter: invert(1);
	}
</style>
