---
import { Icon } from "astro-icon/components";
import { uses } from "../data/uses";

const allTools = uses.flatMap((cat) => cat.tools).filter((t) => t.icon);
---

<section class="pt-16 pb-20 border-t border-border-subtle">
	<div class="max-w-[960px] mx-auto px-6">
		<div class="flex items-baseline gap-3 mb-8 fade-in">
			<h2 class="font-display text-[32px] font-normal">My Stack</h2>
			<span class="font-mono text-[13px] text-text-faint">
				{allTools.length} tools · hover to explore
			</span>
		</div>

		<div class="logo-grid fade-in" id="logo-grid">
			<div class="logo-grid-spotlight" aria-hidden="true"></div>
			{
				allTools.map((tool, i) => (
					<a
						href={tool.url ?? "/uses"}
						target={tool.url ? "_blank" : undefined}
						rel={tool.url ? "noopener noreferrer" : undefined}
						class="logo-tile"
						style={`--i:${i}`}
						aria-label={tool.name}
						title={tool.name}
					>
						<span class="logo-tile-inner">
							<Icon name={tool.icon as string} size={28} />
						</span>
						<span class="logo-tile-label">{tool.name}</span>
					</a>
				))
			}
		</div>

		<div class="flex justify-center mt-14 fade-in">
			<a href="/uses" class="uses-cta">
				<span>See what I use and am familiar with</span>
				<svg
					class="cta-arrow"
					width="18"
					height="18"
					viewBox="0 0 24 24"
					fill="none"
					stroke="currentColor"
					stroke-width="2"
					stroke-linecap="round"
					stroke-linejoin="round"
					aria-hidden="true"
				>
					<path d="M5 12h14M13 5l7 7-7 7"></path>
				</svg>
			</a>
		</div>
	</div>
</section>

<style>
	.logo-grid {
		--tile: 84px;
		--gap: 10px;
		--cols: 8;
		position: relative;
		display: grid;
		grid-template-columns: repeat(var(--cols), minmax(0, 1fr));
		gap: var(--gap);
		padding: 18px;
		border: 1px solid var(--color-border-subtle);
		border-radius: 18px;
		background:
			radial-gradient(
				120% 120% at 50% 0%,
				color-mix(in oklab, var(--color-accent) 4%, transparent) 0%,
				transparent 60%
			),
			var(--color-surface-raised);
		overflow: hidden;
		isolation: isolate;
	}

	@media (max-width: 900px) {
		.logo-grid {
			--cols: 6;
			--tile: 78px;
		}
	}
	@media (max-width: 640px) {
		.logo-grid {
			--cols: 4;
			--tile: 72px;
			padding: 12px;
			gap: 8px;
		}
	}
	@media (max-width: 380px) {
		.logo-grid {
			--cols: 3;
		}
	}

	.logo-grid-spotlight {
		position: absolute;
		inset: 0;
		pointer-events: none;
		opacity: 0;
		transition: opacity 0.4s ease;
		background: radial-gradient(
			220px circle at var(--mx, 50%) var(--my, 50%),
			color-mix(in oklab, var(--color-accent) 22%, transparent),
			transparent 60%
		);
		mix-blend-mode: screen;
		z-index: 0;
	}
	.logo-grid:hover .logo-grid-spotlight {
		opacity: 1;
	}

	.logo-tile {
		position: relative;
		z-index: 1;
		display: flex;
		align-items: center;
		justify-content: center;
		aspect-ratio: 1 / 1;
		min-height: var(--tile);
		border: 1px solid var(--color-border-subtle);
		border-radius: 12px;
		background: color-mix(in oklab, var(--color-surface) 70%, transparent);
		color: var(--color-text-muted);
		overflow: hidden;
		transition:
			border-color 0.25s ease,
			background 0.25s ease,
			color 0.25s ease,
			transform 0.35s cubic-bezier(0.16, 1, 0.3, 1),
			box-shadow 0.35s ease;
		animation:
			tile-in 0.7s cubic-bezier(0.16, 1, 0.3, 1) both,
			tile-pulse 9s ease-in-out infinite;
		animation-delay: calc(var(--i) * 0.04s), calc(var(--i) * 0.18s);
	}

	.logo-tile-inner {
		display: flex;
		align-items: center;
		justify-content: center;
		transition:
			transform 0.35s cubic-bezier(0.16, 1, 0.3, 1),
			color 0.25s ease,
			filter 0.25s ease;
	}

	.logo-tile-label {
		position: absolute;
		bottom: 8px;
		left: 50%;
		transform: translate(-50%, 6px);
		font-family: var(--font-mono);
		font-size: 10px;
		letter-spacing: 0.04em;
		color: var(--color-text-primary);
		background: color-mix(in oklab, var(--color-surface) 92%, transparent);
		padding: 3px 8px;
		border-radius: 999px;
		border: 1px solid var(--color-border-strong);
		opacity: 0;
		pointer-events: none;
		white-space: nowrap;
		max-width: calc(100% - 12px);
		overflow: hidden;
		text-overflow: ellipsis;
		transition:
			opacity 0.2s ease,
			transform 0.25s cubic-bezier(0.16, 1, 0.3, 1);
	}

	.logo-tile::before {
		content: "";
		position: absolute;
		inset: -1px;
		border-radius: inherit;
		padding: 1px;
		background: linear-gradient(
			135deg,
			color-mix(in oklab, var(--color-accent) 60%, transparent),
			transparent 40%,
			color-mix(in oklab, var(--color-accent) 30%, transparent)
		);
		-webkit-mask:
			linear-gradient(#000 0 0) content-box,
			linear-gradient(#000 0 0);
		-webkit-mask-composite: xor;
		mask:
			linear-gradient(#000 0 0) content-box,
			linear-gradient(#000 0 0);
		mask-composite: exclude;
		opacity: 0;
		transition: opacity 0.3s ease;
		pointer-events: none;
	}

	.logo-tile:hover {
		border-color: transparent;
		background: color-mix(in oklab, var(--color-surface-elevated) 95%, var(--color-accent) 5%);
		color: var(--color-text-primary);
		transform: translateY(-3px) scale(1.04);
		box-shadow:
			0 12px 28px -8px color-mix(in oklab, var(--color-accent) 35%, transparent),
			0 4px 12px rgba(0, 0, 0, 0.25);
	}
	.logo-tile:hover::before {
		opacity: 1;
	}
	.logo-tile:hover .logo-tile-inner {
		transform: scale(1.08);
		color: var(--color-text-primary);
		filter: drop-shadow(0 0 6px color-mix(in oklab, var(--color-accent) 60%, transparent));
	}
	.logo-tile:hover .logo-tile-label {
		opacity: 1;
		transform: translate(-50%, 0);
	}

	.logo-tile:focus-visible {
		outline: 2px solid var(--color-accent);
		outline-offset: 2px;
	}

	@keyframes tile-in {
		from {
			opacity: 0;
			filter: blur(8px);
			transform: translateY(10px) scale(0.92);
		}
		to {
			opacity: 1;
			filter: blur(0);
			transform: translateY(0) scale(1);
		}
	}

	@keyframes tile-pulse {
		0%,
		100% {
			border-color: var(--color-border-subtle);
		}
		50% {
			border-color: color-mix(in oklab, var(--color-border-strong) 80%, var(--color-accent) 20%);
		}
	}

	.uses-cta {
		display: inline-flex;
		align-items: center;
		gap: 12px;
		font-family: var(--font-mono);
		font-size: 14px;
		font-weight: 500;
		color: var(--color-text-primary);
		background: var(--color-surface-raised);
		border: 1px solid var(--color-border-strong);
		border-radius: 999px;
		padding: 18px 32px;
		transition:
			background 0.2s,
			border-color 0.2s,
			transform 0.2s,
			box-shadow 0.2s;
	}
	.uses-cta:hover {
		background: var(--color-surface-elevated);
		border-color: var(--color-text-primary);
		transform: translateY(-2px);
		box-shadow: 0 8px 24px rgba(0, 0, 0, 0.18);
	}
	.uses-cta .cta-arrow {
		transition: transform 0.2s;
	}
	.uses-cta:hover .cta-arrow {
		transform: translateX(4px);
	}

	@media (prefers-reduced-motion: reduce) {
		.logo-tile {
			animation: none;
		}
		.logo-tile:hover {
			transform: none;
		}
		.uses-cta:hover {
			transform: none;
		}
	}

	@media (max-width: 640px) {
		.uses-cta {
			font-size: 13px;
			padding: 16px 24px;
		}
	}
</style>

<script>
	const grid = document.getElementById("logo-grid");
	if (grid) {
		const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

		if (!reduced) {
			grid.addEventListener("pointermove", (event) => {
				const rect = grid.getBoundingClientRect();
				const x = ((event.clientX - rect.left) / rect.width) * 100;
				const y = ((event.clientY - rect.top) / rect.height) * 100;
				grid.style.setProperty("--mx", `${x}%`);
				grid.style.setProperty("--my", `${y}%`);
			});
		}
	}
</script>
