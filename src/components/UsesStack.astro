---
import { Icon } from "astro-icon/components";
import { uses } from "../data/uses";

const allTools = uses.flatMap((cat) => cat.tools);
---

<section class="pt-16 pb-20 border-t border-border-subtle">
	<div class="max-w-[960px] mx-auto px-6">
		<div class="flex items-baseline gap-3 mb-8 fade-in">
			<h2 class="font-display text-[32px] font-normal">My Stack</h2>
			<span class="font-mono text-[13px] text-text-faint">
				{allTools.length} tools · why &amp; how
			</span>
		</div>

		<div class="stack-grid">
			{
				allTools.map((tool, i) => (
					<article class="stack-block fade-in" data-offset={i % 4}>
						<div class="stack-block-header">
							<div class="stack-block-logo">
								{tool.icon ? (
									<Icon name={tool.icon} size={22} />
								) : (
									<span class="stack-block-logo-fallback">
										{tool.name.slice(0, 1).toUpperCase()}
									</span>
								)}
							</div>
							<span class="stack-block-name">{tool.name}</span>
						</div>
						{(tool.why || tool.how) && (
							<div class="stack-block-body">
								{tool.why && (
									<div class="stack-block-row">
										<span class="stack-block-label">Why</span>
										<p>{tool.why}</p>
									</div>
								)}
								{tool.how && (
									<div class="stack-block-row">
										<span class="stack-block-label">How</span>
										<p>{tool.how}</p>
									</div>
								)}
							</div>
						)}
					</article>
				))
			}
		</div>

		<div class="flex justify-center mt-14 fade-in">
			<a href="/uses" class="uses-cta">
				<span>See what I use and am familiar with</span>
				<svg
					class="cta-arrow"
					width="18"
					height="18"
					viewBox="0 0 24 24"
					fill="none"
					stroke="currentColor"
					stroke-width="2"
					stroke-linecap="round"
					stroke-linejoin="round"
					aria-hidden="true"
				>
					<path d="M5 12h14M13 5l7 7-7 7"></path>
				</svg>
			</a>
		</div>
	</div>
</section>

<style>
	.stack-grid {
		columns: 3 240px;
		column-gap: 14px;
	}
	@media (max-width: 820px) {
		.stack-grid {
			columns: 2 220px;
		}
	}
	@media (max-width: 540px) {
		.stack-grid {
			columns: 1;
		}
	}

	.stack-block {
		break-inside: avoid;
		display: block;
		width: 100%;
		margin: 0 0 14px;
		padding: 18px 20px 20px;
		background: var(--color-surface-raised);
		border: 1px solid var(--color-border-subtle);
		border-radius: 14px;
		transition:
			border-color 0.2s,
			transform 0.25s,
			box-shadow 0.25s,
			background 0.2s;
	}
	.stack-block[data-offset="1"] {
		margin-top: 22px;
	}
	.stack-block[data-offset="3"] {
		margin-top: 10px;
	}
	.stack-block:hover {
		border-color: var(--color-border-strong);
		background: var(--color-surface-elevated);
		transform: translateY(-2px);
		box-shadow: 0 8px 24px rgba(0, 0, 0, 0.14);
	}

	.stack-block-header {
		display: flex;
		align-items: center;
		gap: 10px;
		margin-bottom: 14px;
	}
	.stack-block-logo {
		width: 32px;
		height: 32px;
		display: flex;
		align-items: center;
		justify-content: center;
		background: var(--color-surface);
		border: 1px solid var(--color-border-subtle);
		border-radius: 8px;
		color: var(--color-text-primary);
		flex-shrink: 0;
	}
	.stack-block-logo-fallback {
		font-family: var(--font-mono);
		font-size: 13px;
		font-weight: 600;
		color: var(--color-text-muted);
	}
	.stack-block-name {
		font-family: var(--font-mono);
		font-size: 13px;
		font-weight: 600;
		color: var(--color-text-primary);
		letter-spacing: 0.01em;
	}

	.stack-block-body {
		display: flex;
		flex-direction: column;
		gap: 12px;
	}
	.stack-block-row {
		display: block;
	}
	.stack-block-label {
		display: block;
		font-family: var(--font-mono);
		font-size: 10px;
		font-weight: 500;
		letter-spacing: 0.12em;
		text-transform: uppercase;
		color: var(--color-text-faint);
		margin-bottom: 4px;
	}
	.stack-block-row p {
		font-size: 13px;
		line-height: 1.55;
		color: var(--color-text-muted);
		margin: 0;
	}

	.uses-cta {
		display: inline-flex;
		align-items: center;
		gap: 12px;
		font-family: var(--font-mono);
		font-size: 14px;
		font-weight: 500;
		color: var(--color-text-primary);
		background: var(--color-surface-raised);
		border: 1px solid var(--color-border-strong);
		border-radius: 999px;
		padding: 18px 32px;
		transition:
			background 0.2s,
			border-color 0.2s,
			transform 0.2s,
			box-shadow 0.2s;
	}
	.uses-cta:hover {
		background: var(--color-surface-elevated);
		border-color: var(--color-text-primary);
		transform: translateY(-2px);
		box-shadow: 0 8px 24px rgba(0, 0, 0, 0.18);
	}
	.uses-cta .cta-arrow {
		transition: transform 0.2s;
	}
	.uses-cta:hover .cta-arrow {
		transform: translateX(4px);
	}

	@media (prefers-reduced-motion: reduce) {
		.stack-block:hover,
		.uses-cta:hover {
			transform: none;
		}
	}

	@media (max-width: 640px) {
		.uses-cta {
			font-size: 13px;
			padding: 16px 24px;
		}
	}
</style>
