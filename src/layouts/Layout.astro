---
import "../styles/global.css";
import ThemeToggle from "../components/ThemeToggle.astro";

interface Props {
	title?: string;
	description?: string;
}

const {
	title = "Luca Silverentand",
	description = "iOS developer, Rust enthusiast, and AI tooling builder. Runs SevenTwo Studio.",
} = Astro.props;

const canonicalUrl = new URL(Astro.url.pathname, Astro.site).href;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<meta name="description" content={description} />
		<meta name="author" content="Luca Silverentand" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:type" content="website" />
		<meta property="og:url" content={canonicalUrl} />
		<meta property="og:image" content={new URL("/og.png", Astro.site).href} />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={new URL("/og.png", Astro.site).href} />
		<link rel="canonical" href={canonicalUrl} />
		<title>{title}</title>
		<link rel="icon" type="image/x-icon" href="/favicon.ico" sizes="32x32" />
		<link rel="icon" type="image/png" href="/favicon-32.png" sizes="32x32" />
		<link rel="icon" type="image/png" href="/favicon-192.png" sizes="192x192" />
		<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
		<script is:inline>
			(function () {
				var s = localStorage.getItem("theme");
				var t =
					s || (window.matchMedia("(prefers-color-scheme: light)").matches ? "light" : "dark");
				document.documentElement.setAttribute("data-theme", t);
			})();
		</script>
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=DM+Serif+Display:ital@0;1&family=DM+Mono:wght@300;400;500&display=swap"
			rel="stylesheet"
		/>
	</head>
	<body>
		<ThemeToggle />
		<slot />
	</body>
</html>

<script>
	// Site-wide reveal-on-scroll observer for `.fade-in` elements.
	// Batches elements that enter the viewport in the same frame and
	// staggers them top-to-bottom with incremental transition-delays.
	// Components that create cards dynamically can call
	// `window.__fadeInObserver?.observe(el)` to opt those in.

	const STAGGER_STEP = 0.07; // seconds between each element in a batch
	const MAX_DELAY = 0.6; // cap so late elements don't feel sluggish
	const CLEANUP_MS = 1200; // remove delay after transition settles

	let pending: Element[] = [];
	let rafScheduled = false;

	function flushBatch() {
		rafScheduled = false;
		if (!pending.length) return;

		// Sort by vertical position so top elements animate first
		const batch = pending
			.map((el) => ({ el, top: el.getBoundingClientRect().top }))
			.sort((a, b) => a.top - b.top);

		pending = [];

		for (let i = 0; i < batch.length; i++) {
			const el = batch[i].el as HTMLElement;
			const delay = Math.min(i * STAGGER_STEP, MAX_DELAY);
			el.style.setProperty("--reveal-delay", `${delay}s`);
			el.classList.add("visible");
			observer.unobserve(el);

			// Clean up the delay after animation finishes so it doesn't
			// interfere with hover/filter transitions later
			setTimeout(() => {
				el.style.removeProperty("--reveal-delay");
			}, (delay + 0.6) * 1000 + CLEANUP_MS);
		}
	}

	const observer = new IntersectionObserver(
		(entries) => {
			for (const entry of entries) {
				if (entry.isIntersecting) {
					pending.push(entry.target);
				}
			}
			if (pending.length && !rafScheduled) {
				rafScheduled = true;
				requestAnimationFrame(flushBatch);
			}
		},
		{ threshold: 0.08, rootMargin: "0px 0px -30px 0px" },
	);
	(window as unknown as { __fadeInObserver: IntersectionObserver }).__fadeInObserver = observer;
	document.querySelectorAll(".fade-in").forEach((el) => observer.observe(el));
</script>
