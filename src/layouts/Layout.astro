---
import "../styles/global.css";
import ThemeToggle from "../components/ThemeToggle.astro";

interface Props {
	title?: string;
	description?: string;
}

const {
	title = "Luca Silverentand",
	description = "iOS developer, Rust enthusiast, and AI tooling builder. Runs SevenTwo Studio.",
} = Astro.props;

const canonicalUrl = new URL(Astro.url.pathname, Astro.site).href;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<meta name="description" content={description} />
		<meta name="author" content="Luca Silverentand" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:type" content="website" />
		<meta property="og:url" content={canonicalUrl} />
		<meta property="og:image" content={new URL("/og.png", Astro.site).href} />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={new URL("/og.png", Astro.site).href} />
		<link rel="canonical" href={canonicalUrl} />
		<title>{title}</title>
		<link rel="icon" type="image/x-icon" href="/favicon.ico" sizes="32x32" />
		<link rel="icon" type="image/png" href="/favicon-32.png" sizes="32x32" />
		<link rel="icon" type="image/png" href="/favicon-192.png" sizes="192x192" />
		<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
		<script is:inline>
			(function () {
				var s = localStorage.getItem("theme");
				var t =
					s || (window.matchMedia("(prefers-color-scheme: light)").matches ? "light" : "dark");
				document.documentElement.setAttribute("data-theme", t);
			})();
		</script>
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=DM+Serif+Display:ital@0;1&family=DM+Mono:wght@300;400;500&display=swap"
			rel="stylesheet"
		/>
	</head>
	<body>
		<ThemeToggle />
		<slot />
	</body>
</html>

<script>
	// Site-wide reveal-on-scroll observer for `.fade-in` elements.
	// Batches elements entering the viewport in the same frame and
	// staggers them top-to-bottom via transition-delay.
	// Elements with data-delay own their stagger (cards, galleries).
	// Re-animates when elements scroll back into view.

	const STAGGER_STEP = 0.07; // seconds between batch elements
	const MAX_DELAY = 0.6;

	let pending: Element[] = [];
	let rafScheduled = false;
	const cleanupTimers = new WeakMap<Element, number>();

	function getDelay(el: HTMLElement, batchIndex: number): number {
		const own = el.dataset.delay;
		if (own) return parseFloat(own);
		return Math.min(batchIndex * STAGGER_STEP, MAX_DELAY);
	}

	function flushBatch() {
		rafScheduled = false;
		if (!pending.length) return;

		const batch = [...pending];
		pending = [];

		for (let i = 0; i < batch.length; i++) {
			const el = batch[i] as HTMLElement;

			const prev = cleanupTimers.get(el);
			if (prev) clearTimeout(prev);

			const own = el.dataset.delay;
			const delay = own ? parseFloat(own) : Math.random() * 0.3;
			el.style.animationDelay = `${delay}s`;
			el.classList.add("visible");

			// Clear delay after animation finishes
			const timer = window.setTimeout(() => {
				cleanupTimers.delete(el);
			}, (delay + 0.7) * 1000);
			cleanupTimers.set(el, timer);
		}
	}

	const observer = new IntersectionObserver(
		(entries) => {
			for (const entry of entries) {
				if (entry.isIntersecting) {
					pending.push(entry.target);
				} else {
					const el = entry.target as HTMLElement;
					const timer = cleanupTimers.get(el);
					if (timer) {
						clearTimeout(timer);
						cleanupTimers.delete(el);
					}
					el.classList.remove("visible");
					el.style.animationDelay = "";
				}
			}
			if (pending.length && !rafScheduled) {
				rafScheduled = true;
				// Double rAF: first frame paints the hidden state (opacity 0,
				// blur), second frame adds .visible so the transition plays.
				requestAnimationFrame(() => requestAnimationFrame(flushBatch));
			}
		},
		{ threshold: 0.08, rootMargin: "0px 0px -30px 0px" },
	);
	(window as unknown as { __fadeInObserver: IntersectionObserver }).__fadeInObserver = observer;
	document.querySelectorAll(".fade-in").forEach((el) => observer.observe(el));
</script>
