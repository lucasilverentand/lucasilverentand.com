---
import Layout from "../layouts/Layout.astro";
import Footer from "../components/Footer.astro";
---

<Layout title="Not Found — Luca Silverentand" description="This page doesn't exist.">
	<main>
		<section class="flex items-center justify-center min-h-[calc(100vh-52px-85px)] text-center">
			<div class="max-w-[960px] mx-auto px-6">
				<span
					class="inline-block font-mono text-[13px] font-medium uppercase tracking-widest text-accent bg-accent-dim px-2.5 py-1 rounded-md mb-5"
					>404</span
				>
				<h1
					class="font-display text-[clamp(36px,6vw,56px)] font-normal leading-tight tracking-tight mb-3"
				>
					Page not found
				</h1>
				<p class="text-[17px] leading-relaxed text-text-2 mb-8">
					The page you're looking for doesn't exist or has been moved.
				</p>
				<a
					href="/"
					class="font-mono text-[13px] text-text-3 transition-colors duration-150 hover:text-text-1"
					>&larr; Back to home</a
				>
			</div>
		</section>
	</main>

	<Footer />
</Layout>
