---
import { getCollection, render } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import Footer from "../../components/Footer.astro";
import SourceBadge from "../../components/SourceBadge.astro";

export async function getStaticPaths() {
	const posts = await getCollection("blog", ({ data }) => !data.draft && !data.imported);
	return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);

function formatDate(date: Date) {
	return date.toLocaleDateString("en-US", { year: "numeric", month: "long", day: "numeric" });
}

const words = post.body?.split(/\s+/).length ?? 0;
const readingTime = Math.max(1, Math.round(words / 230));
const visibleTags = post.data.tags.filter(
	(tag) => tag.trim().toLowerCase() !== post.data.source?.trim().toLowerCase(),
);
---

<Layout title={`${post.data.title} — Luca Silverentand`} description={post.data.description}>
	<main>
		<article>
			<div class="wrap">
				<a href="/blog" class="back">&larr; Back to my writing</a>

				<header>
					<div class="meta">
						{post.data.source && (
							<>
								<SourceBadge source={post.data.source} />
								<span class="separator">&middot;</span>
							</>
						)}
						<time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>
						<span class="separator">&middot;</span>
						{post.data.imported ? (
							<span class="reading-time">Imported article</span>
						) : (
							<span class="reading-time">{readingTime} min read</span>
						)}
					</div>
					<h1>{post.data.title}</h1>
					<p class="description">{post.data.description}</p>
					{visibleTags.length > 0 && (
						<div class="tags">
							{visibleTags.map((tag) => (
								<span class="tag">{tag}</span>
							))}
						</div>
					)}
					{post.data.externalUrl && (
						<p class="external-link">
							<a href={post.data.externalUrl} target="_blank" rel="noopener noreferrer">
								Read the full article &rarr;
							</a>
						</p>
					)}
				</header>

				<div class="prose">
					<Content />
				</div>
			</div>
		</article>
	</main>

	<Footer />
</Layout>

<style>
	.wrap {
		max-width: 720px;
		margin: 0 auto;
		padding: 0 24px;
	}

	/* ── Back link ── */
	.back {
		display: inline-block;
		font-family: var(--font-mono);
		font-size: 13px;
		color: var(--text-3);
		margin-top: 48px;
		margin-bottom: 40px;
		transition: color 0.15s;
	}
	.back:hover { color: var(--text-1); }

	/* ── Header ── */
	header {
		margin-bottom: 48px;
	}
	.meta {
		display: flex;
		align-items: center;
		flex-wrap: wrap;
		row-gap: 8px;
		column-gap: 0;
		margin-bottom: 18px;
		min-height: 14px;
	}
	.meta time,
	.separator,
	.reading-time {
		font-family: var(--font-mono);
		font-size: 13px;
		color: var(--text-3);
		line-height: 1;
		display: inline-flex;
		align-items: center;
	}
	.separator {
		justify-content: center;
		margin: 0 12px;
	}
	.tags {
		display: flex;
		flex-wrap: wrap;
		gap: 8px;
		margin-top: 18px;
	}
	.tag {
		font-family: var(--font-mono);
		font-size: 11px;
		color: var(--text-2);
		background: var(--bg-2);
		border: 1px solid var(--border);
		padding: 5px 10px;
		border-radius: 999px;
		line-height: 1.2;
		overflow-wrap: anywhere;
	}
	header h1 {
		font-family: var(--font-display);
		font-size: clamp(32px, 5vw, 48px);
		font-weight: 400;
		line-height: 1.1;
		letter-spacing: -0.02em;
		margin-bottom: 16px;
	}
	.description {
		font-size: 17px;
		line-height: 1.6;
		color: var(--text-2);
	}
	.external-link {
		margin-top: 18px;
	}
	.external-link :global(a) {
		font-family: var(--font-mono);
		font-size: 13px;
		color: var(--text-1);
		text-decoration: none;
		border-bottom: 1px solid var(--border-2);
		padding-bottom: 2px;
	}
	.external-link :global(a:hover) {
		border-color: var(--text-2);
	}

	/* ── Prose ── */
	.prose {
		padding-bottom: 80px;
	}
	.prose :global(h2) {
		font-family: var(--font-display);
		font-size: 28px;
		font-weight: 400;
		line-height: 1.2;
		margin-top: 48px;
		margin-bottom: 16px;
	}
	.prose :global(h3) {
		font-family: var(--font-display);
		font-size: 22px;
		font-weight: 400;
		margin-top: 36px;
		margin-bottom: 12px;
	}
	.prose :global(p) {
		font-size: 16px;
		line-height: 1.75;
		color: var(--text-2);
		margin-bottom: 20px;
	}
	.prose :global(a) {
		color: var(--text-1);
		text-decoration: underline;
		text-decoration-color: var(--border-2);
		text-underline-offset: 3px;
		transition: text-decoration-color 0.15s;
	}
	.prose :global(a:hover) {
		text-decoration-color: var(--text-2);
	}
	.prose :global(strong) {
		color: var(--text-1);
		font-weight: 600;
	}
	.prose :global(ul),
	.prose :global(ol) {
		padding-left: 24px;
		margin-bottom: 20px;
	}
	.prose :global(li) {
		font-size: 16px;
		line-height: 1.75;
		color: var(--text-2);
		margin-bottom: 6px;
	}
	.prose :global(code) {
		font-family: var(--font-mono);
		font-size: 14px;
		background: var(--bg-3);
		padding: 2px 6px;
		border-radius: 4px;
		color: var(--text-1);
	}
	.prose :global(pre) {
		background: var(--bg-2);
		border: 1px solid var(--border);
		border-radius: 10px;
		padding: 20px 24px;
		overflow-x: auto;
		margin-bottom: 24px;
	}
	.prose :global(pre code) {
		background: none;
		padding: 0;
		font-size: 13px;
		line-height: 1.7;
	}
	.prose :global(blockquote) {
		border-left: 2px solid var(--border-2);
		padding-left: 20px;
		margin-bottom: 20px;
	}
	.prose :global(blockquote p) {
		color: var(--text-3);
		font-style: italic;
	}
	.prose :global(hr) {
		border: none;
		border-top: 1px solid var(--border);
		margin: 40px 0;
	}
</style>
