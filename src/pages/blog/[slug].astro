---
import { getCollection, render } from "astro:content";
import Layout from "../../layouts/Layout.astro";

export async function getStaticPaths() {
	const posts = await getCollection("blog", ({ data }) => !data.draft);
	return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);

function formatDate(date: Date) {
	return date.toLocaleDateString("en-US", { year: "numeric", month: "long", day: "numeric" });
}
---

<Layout title={`${post.data.title} — Luca Silverentand`} description={post.data.description}>
	<nav>
		<div class="wrap">
			<a href="/" class="logo">LS</a>
			<div class="nav-links">
				<a href="/blog">Blog</a>
				<a href="https://github.com/lucasilverentand" target="_blank" rel="noopener">GitHub</a>
			</div>
		</div>
	</nav>

	<main>
		<article>
			<div class="wrap">
				<a href="/blog" class="back">&larr; Back to blog</a>

				<header>
					<div class="meta">
						<time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>
						<div class="tags">
							{post.data.tags.map((tag) => (
								<span class="tag">{tag}</span>
							))}
						</div>
					</div>
					<h1>{post.data.title}</h1>
					<p class="description">{post.data.description}</p>
				</header>

				<div class="prose">
					<Content />
				</div>
			</div>
		</article>
	</main>

	<footer>
		<div class="wrap">
			<span>Luca Silverentand &copy; 2025</span>
			<div class="footer-links">
				<a href="/">Home</a>
				<a href="/blog">Blog</a>
				<a href="https://github.com/lucasilverentand" target="_blank" rel="noopener">GitHub</a>
			</div>
		</div>
	</footer>
</Layout>

<style>
	.wrap {
		max-width: 720px;
		margin: 0 auto;
		padding: 0 24px;
	}

	/* ── Nav ── */
	nav {
		position: sticky;
		top: 0;
		z-index: 50;
		background: rgba(10, 10, 10, 0.8);
		backdrop-filter: blur(12px);
		-webkit-backdrop-filter: blur(12px);
		border-bottom: 1px solid var(--border);
	}
	nav .wrap {
		max-width: 960px;
		display: flex;
		align-items: center;
		justify-content: space-between;
		height: 52px;
	}
	.logo {
		font-family: var(--font-mono);
		font-size: 14px;
		font-weight: 500;
		color: var(--text-1);
		letter-spacing: 0.04em;
	}
	.nav-links {
		display: flex;
		gap: 24px;
	}
	.nav-links a {
		font-family: var(--font-mono);
		font-size: 13px;
		color: var(--text-3);
		transition: color 0.15s;
	}
	.nav-links a:hover { color: var(--text-1); }

	/* ── Back link ── */
	.back {
		display: inline-block;
		font-family: var(--font-mono);
		font-size: 13px;
		color: var(--text-3);
		margin-top: 48px;
		margin-bottom: 40px;
		transition: color 0.15s;
	}
	.back:hover { color: var(--text-1); }

	/* ── Header ── */
	header {
		margin-bottom: 48px;
	}
	.meta {
		display: flex;
		align-items: center;
		gap: 12px;
		margin-bottom: 20px;
	}
	.meta time {
		font-family: var(--font-mono);
		font-size: 13px;
		color: var(--text-3);
	}
	.tags {
		display: flex;
		gap: 6px;
	}
	.tag {
		font-family: var(--font-mono);
		font-size: 11px;
		color: var(--accent);
		background: var(--accent-dim);
		padding: 2px 8px;
		border-radius: 4px;
	}
	header h1 {
		font-family: var(--font-display);
		font-size: clamp(32px, 5vw, 48px);
		font-weight: 400;
		line-height: 1.1;
		letter-spacing: -0.02em;
		margin-bottom: 16px;
	}
	.description {
		font-size: 17px;
		line-height: 1.6;
		color: var(--text-2);
	}

	/* ── Prose ── */
	.prose {
		padding-bottom: 80px;
	}
	.prose :global(h2) {
		font-family: var(--font-display);
		font-size: 28px;
		font-weight: 400;
		line-height: 1.2;
		margin-top: 48px;
		margin-bottom: 16px;
	}
	.prose :global(h3) {
		font-family: var(--font-display);
		font-size: 22px;
		font-weight: 400;
		margin-top: 36px;
		margin-bottom: 12px;
	}
	.prose :global(p) {
		font-size: 16px;
		line-height: 1.75;
		color: var(--text-2);
		margin-bottom: 20px;
	}
	.prose :global(a) {
		color: var(--text-1);
		text-decoration: underline;
		text-decoration-color: var(--border-2);
		text-underline-offset: 3px;
		transition: text-decoration-color 0.15s;
	}
	.prose :global(a:hover) {
		text-decoration-color: var(--text-2);
	}
	.prose :global(strong) {
		color: var(--text-1);
		font-weight: 600;
	}
	.prose :global(ul),
	.prose :global(ol) {
		padding-left: 24px;
		margin-bottom: 20px;
	}
	.prose :global(li) {
		font-size: 16px;
		line-height: 1.75;
		color: var(--text-2);
		margin-bottom: 6px;
	}
	.prose :global(code) {
		font-family: var(--font-mono);
		font-size: 14px;
		background: var(--bg-3);
		padding: 2px 6px;
		border-radius: 4px;
		color: var(--text-1);
	}
	.prose :global(pre) {
		background: var(--bg-2);
		border: 1px solid var(--border);
		border-radius: 10px;
		padding: 20px 24px;
		overflow-x: auto;
		margin-bottom: 24px;
	}
	.prose :global(pre code) {
		background: none;
		padding: 0;
		font-size: 13px;
		line-height: 1.7;
	}
	.prose :global(blockquote) {
		border-left: 2px solid var(--border-2);
		padding-left: 20px;
		margin-bottom: 20px;
	}
	.prose :global(blockquote p) {
		color: var(--text-3);
		font-style: italic;
	}
	.prose :global(hr) {
		border: none;
		border-top: 1px solid var(--border);
		margin: 40px 0;
	}

	/* ── Footer ── */
	footer {
		border-top: 1px solid var(--border);
		padding: 28px 0;
	}
	footer .wrap {
		max-width: 960px;
		display: flex;
		align-items: center;
		justify-content: space-between;
	}
	footer span {
		font-family: var(--font-mono);
		font-size: 12px;
		color: var(--text-3);
	}
	.footer-links {
		display: flex;
		gap: 20px;
	}
	.footer-links a {
		font-family: var(--font-mono);
		font-size: 12px;
		color: var(--text-3);
		transition: color 0.15s;
	}
	.footer-links a:hover { color: var(--text-1); }
</style>
