---
import { getCollection } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import Footer from "../../components/Footer.astro";
import SourceBadge from "../../components/SourceBadge.astro";
import { getExternalArticles, toWritingEntry } from "../../lib/writing";

const posts = [
	...(await getCollection("blog", ({ data }) => !data.draft)).map(toWritingEntry),
	...getExternalArticles(),
].sort((a, b) => b.date.getTime() - a.date.getTime());

function formatDate(date: Date) {
	return date.toLocaleDateString("en-US", { year: "numeric", month: "short", day: "numeric" });
}

function visibleTags(post: (typeof posts)[number]) {
	const sourceTag = post.source?.trim().toLowerCase();
	return post.tags.filter((tag) => tag.trim().toLowerCase() !== sourceTag);
}

function postHref(post: (typeof posts)[number]) {
	return post.externalUrl ?? `/blog/${post.id}`;
}
---

<Layout
	title="My Writing — Luca Silverentand"
	description="All of my writing in one place: all my articles, newsletter, and other published writing."
>
	<main>
		<section class="blog-hero">
			<div class="wrap">
				<a href="/" class="back">&larr; Back to home</a>
				<h1>My Writing</h1>
				<p class="subtitle">All of my writing in one place: all my articles, newsletter, and other published writing.</p>
			</div>
		</section>

		<section class="posts">
			<div class="wrap">
				{posts.map((post) => (
					<a
						href={postHref(post)}
						class="post-card"
						target={post.externalUrl ? "_blank" : undefined}
						rel={post.externalUrl ? "noopener noreferrer" : undefined}
					>
						<div class="post-meta">
							{post.source && (
								<>
									<SourceBadge source={post.source} />
									<span class="separator">&middot;</span>
								</>
							)}
							<time datetime={post.date.toISOString()}>{formatDate(post.date)}</time>
						</div>
						<h2>{post.title}</h2>
						<p>{post.description}</p>
						{visibleTags(post).length > 0 && (
							<div class="post-labels">
								{visibleTags(post).map((tag) => (
									<span class="tag">{tag}</span>
								))}
							</div>
						)}
					</a>
				))}

				{posts.length === 0 && (
					<p class="empty">No posts yet. Check back soon.</p>
				)}
			</div>
		</section>
	</main>

	<Footer />
</Layout>

<style>
	.wrap {
		max-width: 960px;
		margin: 0 auto;
		padding: 0 24px;
	}

	/* ── Blog hero ── */
	.blog-hero {
		padding: 100px 0 60px;
	}
	.back {
		display: inline-block;
		font-family: var(--font-mono);
		font-size: 13px;
		color: var(--text-3);
		margin-bottom: 32px;
		transition: color 0.15s;
	}
	.back:hover {
		color: var(--text-1);
	}
	.blog-hero h1 {
		font-family: var(--font-display);
		font-size: clamp(40px, 6vw, 64px);
		font-weight: 400;
		line-height: 1;
		letter-spacing: -0.025em;
		margin-bottom: 16px;
	}
	.subtitle {
		font-size: 17px;
		color: var(--text-2);
		line-height: 1.6;
	}

	/* ── Posts ── */
	.posts {
		padding-bottom: 80px;
	}
	.post-card {
		display: block;
		padding: 28px 0;
		border-bottom: 1px solid var(--border);
		transition: opacity 0.15s;
	}
	.post-card:first-child {
		border-top: 1px solid var(--border);
	}
	.post-card:hover {
		opacity: 0.8;
	}
	.post-meta {
		display: flex;
		align-items: center;
		flex-wrap: wrap;
		row-gap: 8px;
		column-gap: 0;
		margin-bottom: 10px;
		min-height: 14px;
	}
	.post-meta time,
	.separator {
		font-family: var(--font-mono);
		font-size: 12px;
		color: var(--text-3);
		line-height: 1;
		display: inline-flex;
		align-items: center;
	}
	.separator {
		justify-content: center;
		margin: 0 10px;
	}
	.post-labels {
		display: flex;
		flex-wrap: wrap;
		gap: 8px;
		margin-top: 16px;
		max-width: 720px;
	}
	.tag {
		font-family: var(--font-mono);
		font-size: 11px;
		color: var(--text-2);
		background: var(--bg-2);
		border: 1px solid var(--border);
		padding: 5px 10px;
		border-radius: 999px;
		line-height: 1.2;
		overflow-wrap: anywhere;
	}
	.post-card h2 {
		font-family: var(--font-display);
		font-size: 26px;
		font-weight: 400;
		line-height: 1.2;
		margin-bottom: 8px;
	}
	.post-card p {
		font-size: 15px;
		line-height: 1.6;
		color: var(--text-2);
		max-width: 640px;
	}
	@media (max-width: 640px) {
		.post-labels {
			gap: 6px;
		}
		.tag {
			font-size: 10px;
			padding: 5px 9px;
		}
	}
	.empty {
		font-size: 15px;
		color: var(--text-3);
		padding: 40px 0;
	}
</style>
