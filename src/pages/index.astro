---
import Layout from "../layouts/Layout.astro";

const projects = {
	ai: [
		{
			name: "skills",
			desc: "72 Claude Code skills organized into 16 plugins and 7 intent-based bundles",
			lang: "TypeScript",
			stars: 2,
			url: "https://github.com/lucasilverentand/skills",
		},
		{
			name: "tkn",
			desc: "Shell proxy that optimizes CLI output for AI coding assistants by reducing token usage",
			lang: "Rust",
			stars: 1,
			url: "https://github.com/lucasilverentand/tkn",
		},
		{
			name: "claudeline",
			desc: "Customizable status line for Claude Code with themes, git, and cost tracking",
			lang: "TypeScript",
			stars: 1,
			url: "https://github.com/lucasilverentand/claudeline",
		},
		{
			name: "pane",
			desc: "TUI agent manager with daemon, protocol, and terminal interface",
			lang: "Rust",
			url: "https://github.com/lucasilverentand/pane",
		},
		{
			name: "clusage",
			desc: "macOS menu bar app to track Claude API usage across multiple accounts",
			lang: "Swift",
			url: "https://github.com/lucasilverentand/clusage",
		},
		{
			name: "apple-music-mcp",
			desc: "MCP server for controlling Apple Music from Claude Code",
			lang: "TypeScript",
			url: "https://github.com/lucasilverentand/apple-music-mcp",
		},
	],
	infra: [
		{
			name: "kustodian",
			desc: "GitOps templating framework for Kubernetes with Flux CD",
			lang: "TypeScript",
			url: "https://github.com/lucasilverentand/kustodian",
		},
		{
			name: "canaveral",
			desc: "CLI for automated package and app release workflows",
			lang: "Rust",
			url: "https://github.com/lucasilverentand/canaveral",
		},
		{
			name: "tarmac",
			desc: "Native macOS app that runs ephemeral GitHub Actions runners inside virtual macOS VMs on Apple Silicon",
			lang: "Swift",
			url: "https://github.com/lucasilverentand/tarmac",
		},
		{
			name: "dot-steward",
			desc: "CLI for declarative dotfile management with symlink tracking",
			lang: "Rust",
			url: "https://github.com/lucasilverentand/dot-steward",
		},
		{
			name: "unifi-cli",
			desc: "CLI and MCP server for the UniFi Network API with 67 auto-generated commands",
			lang: "TypeScript",
			url: "https://github.com/lucasilverentand/unifi-cli",
		},
	],
	misc: [
		{
			name: "ha-inhabit",
			desc: "Visual home editor and sensor automation for Home Assistant",
			lang: "Python",
			url: "https://github.com/lucasilverentand/ha-inhabit",
		},
		{
			name: "lumo-optimized",
			desc: "Performance-focused Fabric modpack for Minecraft 1.21.8",
			lang: "JavaScript",
			url: "https://github.com/lucasilverentand/lumo-optimized",
		},
		{
			name: "lumo-server",
			desc: "Docker image for running a modded Minecraft server",
			lang: "Python",
			url: "https://github.com/lucasilverentand/lumo-server",
		},
	],
};

const langColor: Record<string, string> = {
	Swift: "var(--lang-swift)",
	Rust: "var(--lang-rust)",
	TypeScript: "var(--lang-ts)",
	JavaScript: "var(--lang-js)",
	Python: "var(--lang-python)",
};
---

<Layout>
	<!-- NAV -->
	<nav>
		<div class="nav-inner">
			<a href="/" class="nav-logo">
				<span class="logo-mark">LS</span>
			</a>
			<div class="nav-links">
				<a href="https://github.com/lucasilverentand" target="_blank" rel="noopener" class="nav-link">
					GitHub
				</a>
				<a href="https://linear.app" target="_blank" rel="noopener" class="nav-link">
					Linear
				</a>
				<a
					href="https://apps.apple.com/app/headhigh/id6748973690"
					target="_blank"
					rel="noopener"
					class="nav-cta"
				>
					Get HeadHigh
				</a>
			</div>
		</div>
	</nav>

	<main>
		<!-- HERO -->
		<section class="hero">
			<div class="hero-bg-grid"></div>
			<div class="container">
				<div class="hero-eyebrow">
					<span class="dot"></span>
					<span>Available for select projects</span>
				</div>
				<h1 class="hero-name">Luca<br />Silverentand</h1>
				<div class="hero-roles">
					<span>iOS Developer</span>
					<span class="sep">/</span>
					<span>Rust Enthusiast</span>
					<span class="sep">/</span>
					<span>AI Tooling Builder</span>
				</div>
				<p class="hero-desc">
					Founder of <a href="https://github.com/seventwo-studio" target="_blank" rel="noopener" class="inline-link">SevenTwo Studio</a>.
					I build native Apple apps, developer tools in Rust, and AI-augmented workflows.
					Currently shipping <a href="#headhigh" class="inline-link">HeadHigh</a> and a suite of
					open-source tools for the Claude Code ecosystem.
				</p>
				<div class="hero-actions">
					<a href="https://github.com/lucasilverentand" target="_blank" rel="noopener" class="btn-ghost">
						<svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
							<path d="M12 0C5.374 0 0 5.373 0 12c0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23A11.509 11.509 0 0 1 12 5.803c1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576C20.566 21.797 24 17.3 24 12c0-6.627-5.373-12-12-12z"/>
						</svg>
						lucasilverentand
					</a>
					<a href="mailto:luca@seventwo.studio" class="btn-ghost">
						<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
							<path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/>
							<polyline points="22,6 12,13 2,6"/>
						</svg>
						luca@seventwo.studio
					</a>
				</div>
			</div>
		</section>

		<!-- HEADHIGH FEATURED APP -->
		<section class="featured" id="headhigh">
			<div class="container">
				<div class="section-label">
					<span class="section-num">01</span>
					<span>Featured App</span>
				</div>
				<div class="featured-card">
					<div class="featured-left">
						<div class="app-badge">
							<div class="app-icon-wrap">
								<svg width="40" height="40" viewBox="0 0 40 40" fill="none">
									<rect width="40" height="40" rx="10" fill="#1a1a1a"/>
									<path d="M20 8C20 8 14 12 14 20C14 24.4 16.8 28 20 30C23.2 28 26 24.4 26 20C26 12 20 8 20 8Z" fill="#ff5c1a" opacity="0.9"/>
									<path d="M20 13C20 13 17 16 17 20C17 22.2 18.3 24 20 25C21.7 24 23 22.2 23 20C23 16 20 13 20 13Z" fill="white"/>
								</svg>
							</div>
							<div class="app-meta">
								<div class="app-platform">iOS App</div>
								<div class="app-tech">Swift · SwiftUI · AirPods</div>
							</div>
						</div>
						<h2 class="app-name">HeadHigh</h2>
						<p class="app-desc">
							Real-time posture correction using AirPods motion data.
							HeadHigh monitors your head position throughout the day and delivers
							subtle haptic nudges when you slouch — no wearables, no cameras,
							just the AirPods already in your ears.
						</p>
						<ul class="app-features">
							<li>
								<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="var(--accent)" stroke-width="2">
									<polyline points="20 6 9 17 4 12"/>
								</svg>
								Live head tilt detection via CoreMotion
							</li>
							<li>
								<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="var(--accent)" stroke-width="2">
									<polyline points="20 6 9 17 4 12"/>
								</svg>
								Configurable sensitivity and alert thresholds
							</li>
							<li>
								<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="var(--accent)" stroke-width="2">
									<polyline points="20 6 9 17 4 12"/>
								</svg>
								Background monitoring with minimal battery drain
							</li>
							<li>
								<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="var(--accent)" stroke-width="2">
									<polyline points="20 6 9 17 4 12"/>
								</svg>
								Daily posture history and streaks
							</li>
						</ul>
						<div class="app-links">
							<a
								href="https://apps.apple.com/app/headhigh/id6748973690"
								target="_blank"
								rel="noopener"
								class="appstore-btn"
							>
								<svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
									<path d="M18.71 19.5c-.83 1.24-1.71 2.45-3.05 2.47-1.34.03-1.77-.79-3.29-.79-1.53 0-2 .77-3.27.82-1.31.05-2.3-1.32-3.14-2.53C4.25 17 2.94 12.45 4.7 9.39c.87-1.52 2.43-2.48 4.12-2.51 1.28-.02 2.5.87 3.29.87.78 0 2.26-1.07 3.8-.91.65.03 2.47.26 3.64 1.98-.09.06-2.17 1.28-2.15 3.81.03 3.02 2.65 4.03 2.68 4.04-.03.07-.42 1.44-1.38 2.83M13 3.5c.73-.83 1.94-1.46 2.94-1.5.13 1.17-.34 2.35-1.04 3.19-.69.85-1.83 1.51-2.95 1.42-.15-1.15.41-2.35 1.05-3.11z"/>
								</svg>
								Download on App Store
							</a>
							<a
								href="https://github.com/seventwo-studio/headhigh"
								target="_blank"
								rel="noopener"
								class="btn-outline"
							>
								<svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
									<path d="M12 0C5.374 0 0 5.373 0 12c0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23A11.509 11.509 0 0 1 12 5.803c1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576C20.566 21.797 24 17.3 24 12c0-6.627-5.373-12-12-12z"/>
								</svg>
								View Source
							</a>
						</div>
					</div>
					<div class="featured-right">
						<div class="phone-mockup">
							<div class="phone-screen">
								<div class="phone-status">
									<span class="phone-time">9:41</span>
									<span class="phone-icons">
										<svg width="14" height="10" viewBox="0 0 14 10" fill="white">
											<rect x="0" y="2" width="3" height="8" rx="0.5" fill-opacity="0.4"/>
											<rect x="4" y="1" width="3" height="9" rx="0.5" fill-opacity="0.6"/>
											<rect x="8" y="0" width="3" height="10" rx="0.5"/>
										</svg>
									</span>
								</div>
								<div class="phone-app">
									<div class="phone-app-header">
										<div class="posture-score">
											<div class="score-ring">
												<svg viewBox="0 0 80 80" width="80" height="80">
													<circle cx="40" cy="40" r="34" fill="none" stroke="#1a1a1a" stroke-width="6"/>
													<circle cx="40" cy="40" r="34" fill="none" stroke="#ff5c1a" stroke-width="6"
														stroke-dasharray="184" stroke-dashoffset="46"
														stroke-linecap="round" transform="rotate(-90 40 40)"/>
												</svg>
												<div class="score-inner">
													<span class="score-val">87</span>
													<span class="score-label">score</span>
												</div>
											</div>
											<div class="score-status">
												<span class="status-indicator good"></span>
												<span>Good posture</span>
											</div>
										</div>
									</div>
									<div class="phone-stats">
										<div class="stat-item">
											<span class="stat-val">4h 12m</span>
											<span class="stat-lbl">Monitored</span>
										</div>
										<div class="stat-divider"></div>
										<div class="stat-item">
											<span class="stat-val">3</span>
											<span class="stat-lbl">Nudges</span>
										</div>
										<div class="stat-divider"></div>
										<div class="stat-item">
											<span class="stat-val">7d</span>
											<span class="stat-lbl">Streak</span>
										</div>
									</div>
									<div class="phone-chart">
										<div class="chart-bars">
											<div class="bar" style="height: 60%"></div>
											<div class="bar" style="height: 75%"></div>
											<div class="bar" style="height: 50%"></div>
											<div class="bar good" style="height: 85%"></div>
											<div class="bar good" style="height: 90%"></div>
											<div class="bar good" style="height: 88%"></div>
											<div class="bar active" style="height: 87%"></div>
										</div>
										<div class="chart-labels">
											<span>Mon</span>
											<span>Tue</span>
											<span>Wed</span>
											<span>Thu</span>
											<span>Fri</span>
											<span>Sat</span>
											<span>Sun</span>
										</div>
									</div>
								</div>
							</div>
						</div>
					</div>
				</div>
			</div>
		</section>

		<!-- OPEN SOURCE -->
		<section class="projects" id="projects">
			<div class="container">
				<div class="section-label">
					<span class="section-num">02</span>
					<span>Open Source</span>
				</div>
				<p class="section-desc">
					Tools I build and maintain publicly. Most live at{" "}
					<a href="https://github.com/lucasilverentand" target="_blank" rel="noopener" class="inline-link">
						github.com/lucasilverentand
					</a>.
				</p>

				<!-- AI Tools -->
				<div class="project-group">
					<h3 class="group-title">
						<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="var(--accent)" stroke-width="1.5">
							<path d="M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5"/>
						</svg>
						AI Developer Tools
					</h3>
					<div class="project-grid">
						{projects.ai.map((p) => (
							<a href={p.url} target="_blank" rel="noopener" class="project-card">
								<div class="card-top">
									<span class="project-name">{p.name}</span>
									{p.stars && (
										<span class="star-badge">
											<svg width="11" height="11" viewBox="0 0 24 24" fill="currentColor">
												<path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
											</svg>
											{p.stars}
										</span>
									)}
								</div>
								<p class="project-desc">{p.desc}</p>
								<div class="card-bottom">
									<span class="lang-badge" style={`--lang-color: ${langColor[p.lang] ?? "var(--text-3)"}`}>
										<span class="lang-dot"></span>
										{p.lang}
									</span>
									<span class="card-arrow">↗</span>
								</div>
							</a>
						))}
					</div>
				</div>

				<!-- Infra Tools -->
				<div class="project-group">
					<h3 class="group-title">
						<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="var(--accent)" stroke-width="1.5">
							<rect x="2" y="2" width="20" height="8" rx="2" ry="2"/>
							<rect x="2" y="14" width="20" height="8" rx="2" ry="2"/>
							<line x1="6" y1="6" x2="6.01" y2="6"/>
							<line x1="6" y1="18" x2="6.01" y2="18"/>
						</svg>
						Developer & Infrastructure
					</h3>
					<div class="project-grid">
						{projects.infra.map((p) => (
							<a href={p.url} target="_blank" rel="noopener" class="project-card">
								<div class="card-top">
									<span class="project-name">{p.name}</span>
								</div>
								<p class="project-desc">{p.desc}</p>
								<div class="card-bottom">
									<span class="lang-badge" style={`--lang-color: ${langColor[p.lang] ?? "var(--text-3)"}`}>
										<span class="lang-dot"></span>
										{p.lang}
									</span>
									<span class="card-arrow">↗</span>
								</div>
							</a>
						))}
					</div>
				</div>

				<!-- Misc -->
				<div class="project-group">
					<h3 class="group-title">
						<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="var(--accent)" stroke-width="1.5">
							<circle cx="12" cy="12" r="10"/>
							<path d="M12 8v4l3 3"/>
						</svg>
						Home & Gaming
					</h3>
					<div class="project-grid">
						{projects.misc.map((p) => (
							<a href={p.url} target="_blank" rel="noopener" class="project-card">
								<div class="card-top">
									<span class="project-name">{p.name}</span>
								</div>
								<p class="project-desc">{p.desc}</p>
								<div class="card-bottom">
									<span class="lang-badge" style={`--lang-color: ${langColor[p.lang] ?? "var(--text-3)"}`}>
										<span class="lang-dot"></span>
										{p.lang}
									</span>
									<span class="card-arrow">↗</span>
								</div>
							</a>
						))}
					</div>
				</div>
			</div>
		</section>
	</main>

	<!-- FOOTER -->
	<footer>
		<div class="container">
			<div class="footer-inner">
				<div class="footer-left">
					<span class="footer-name">Luca Silverentand</span>
					<span class="footer-copy">© 2025</span>
				</div>
				<div class="footer-links">
					<a href="https://github.com/lucasilverentand" target="_blank" rel="noopener">GitHub</a>
					<a href="https://github.com/seventwo-studio" target="_blank" rel="noopener">SevenTwo Studio</a>
					<a href="https://apps.apple.com/app/headhigh/id6748973690" target="_blank" rel="noopener">HeadHigh</a>
				</div>
			</div>
		</div>
	</footer>
</Layout>

<style>
	/* ── CONTAINER ── */
	.container {
		max-width: 1100px;
		margin: 0 auto;
		padding: 0 24px;
	}

	/* ── NAV ── */
	nav {
		position: fixed;
		top: 0;
		left: 0;
		right: 0;
		z-index: 100;
		border-bottom: 1px solid var(--border);
		background: rgba(8, 8, 8, 0.85);
		backdrop-filter: blur(12px);
		-webkit-backdrop-filter: blur(12px);
	}

	.nav-inner {
		max-width: 1100px;
		margin: 0 auto;
		padding: 0 24px;
		height: 56px;
		display: flex;
		align-items: center;
		justify-content: space-between;
	}

	.nav-logo {
		display: flex;
		align-items: center;
		gap: 8px;
	}

	.logo-mark {
		font-family: var(--font-mono);
		font-size: 14px;
		font-weight: 500;
		color: var(--text-1);
		background: var(--bg-3);
		border: 1px solid var(--border-2);
		padding: 4px 8px;
		border-radius: 6px;
		letter-spacing: 0.05em;
		transition: border-color 0.2s, color 0.2s;
	}

	.nav-logo:hover .logo-mark {
		border-color: var(--accent);
		color: var(--accent);
	}

	.nav-links {
		display: flex;
		align-items: center;
		gap: 8px;
	}

	.nav-link {
		font-family: var(--font-mono);
		font-size: 12px;
		color: var(--text-2);
		padding: 6px 12px;
		border-radius: 6px;
		transition: color 0.2s, background 0.2s;
	}

	.nav-link:hover {
		color: var(--text-1);
		background: var(--bg-3);
	}

	.nav-cta {
		font-family: var(--font-mono);
		font-size: 12px;
		color: var(--accent);
		border: 1px solid var(--accent);
		padding: 6px 14px;
		border-radius: 6px;
		transition: background 0.2s, color 0.2s;
	}

	.nav-cta:hover {
		background: var(--accent);
