---
import { getCollection } from "astro:content";
import Layout from "../layouts/Layout.astro";
import Footer from "../components/Footer.astro";
import Hero from "../components/Hero.astro";
import LunarPromo from "../components/LunarPromo.astro";
import HeadHighPromo from "../components/HeadHighPromo.astro";
import WritingGallery from "../components/WritingGallery.astro";
import ProjectsSection from "../components/ProjectsSection.astro";
import { getExternalArticles, toWritingEntry } from "../lib/writing";

const allPosts = [
	...(await getCollection("blog", ({ data }) => !data.draft)).map(toWritingEntry),
	...getExternalArticles(),
].sort((a, b) => b.date.getTime() - a.date.getTime());

const recentPosts = allPosts.slice(0, 8);
---

<Layout>
	<main>
		<Hero />
		<LunarPromo />
		<HeadHighPromo />
		<WritingGallery posts={recentPosts} totalCount={allPosts.length} />
		<ProjectsSection />
	</main>

	<Footer />
</Layout>
