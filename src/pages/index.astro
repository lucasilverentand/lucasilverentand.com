---
import { getCollection } from "astro:content";
import { Icon } from "astro-icon/components";
import Layout from "../layouts/Layout.astro";
import Footer from "../components/Footer.astro";
import DitheredPortrait from "../components/DitheredPortrait.astro";
import { getExternalArticles, toWritingEntry } from "../lib/writing";

const allPosts = [
	...(await getCollection("blog", ({ data }) => !data.draft)).map(toWritingEntry),
	...getExternalArticles(),
].sort((a, b) => b.date.getTime() - a.date.getTime());

const recentPosts = allPosts.slice(0, 3);
const remainingCount = allPosts.length - recentPosts.length;

function formatDate(date: Date) {
	return date.toLocaleDateString("en-US", { year: "numeric", month: "short", day: "numeric" });
}

function postHref(post: (typeof recentPosts)[number]) {
	return post.externalUrl ?? `/blog/${post.id}`;
}

const ai = [
	{
		name: "skills",
		desc: "72 Claude Code skills in 16 plugins and 7 intent-based bundles",
		lang: "TypeScript",
		stars: 2,
		url: "https://github.com/lucasilverentand/skills",
	},
	{
		name: "tkn",
		desc: "Shell proxy that optimizes CLI output for AI assistants by reducing token usage",
		lang: "Rust",
		stars: 1,
		url: "https://github.com/lucasilverentand/tkn",
	},
	{
		name: "claudeline",
		desc: "Customizable status line for Claude Code with themes, git, and cost tracking",
		lang: "TypeScript",
		stars: 1,
		url: "https://github.com/lucasilverentand/claudeline",
	},
	{
		name: "pane",
		desc: "Terminal multiplexer and macOS app for managing AI coding agents",
		lang: "Rust",
		url: "https://github.com/lucasilverentand/pane",
	},
	{
		name: "clusage",
		desc: "macOS menu bar app to track Claude API usage across multiple accounts",
		lang: "Swift",
		url: "https://github.com/lucasilverentand/clusage",
	},
	{
		name: "apple-music-mcp",
		desc: "MCP server for controlling Apple Music from Claude Code",
		lang: "TypeScript",
		url: "https://github.com/lucasilverentand/apple-music-mcp",
	},
];

const infra = [
	{
		name: "kustodian",
		desc: "GitOps templating framework for Kubernetes with Flux CD",
		lang: "TypeScript",
		url: "https://github.com/lucasilverentand/kustodian",
	},
	{
		name: "canaveral",
		desc: "CLI for automated package and app release workflows",
		lang: "Rust",
		url: "https://github.com/lucasilverentand/canaveral",
	},
	{
		name: "tarmac",
		desc: "Runs ephemeral GitHub Actions runners inside virtual macOS VMs on Apple Silicon",
		lang: "Swift",
		url: "https://github.com/lucasilverentand/tarmac",
	},
	{
		name: "dot-steward",
		desc: "Declarative dotfile management with symlink tracking",
		lang: "Rust",
		url: "https://github.com/lucasilverentand/dot-steward",
	},
	{
		name: "unifi-cli",
		desc: "CLI and MCP server for the UniFi Network API with 67 auto-generated commands",
		lang: "TypeScript",
		url: "https://github.com/lucasilverentand/unifi-cli",
	},
];

const misc = [
	{
		name: "ha-inhabit",
		desc: "Visual home editor and sensor automation for Home Assistant",
		lang: "Python",
		url: "https://github.com/lucasilverentand/ha-inhabit",
	},
	{
		name: "lumo-optimized",
		desc: "Performance-focused Fabric modpack for Minecraft 1.21.8",
		lang: "JavaScript",
		url: "https://github.com/lucasilverentand/lumo-optimized",
	},
	{
		name: "lumo-server",
		desc: "Docker image for running a modded Minecraft server",
		lang: "Python",
		url: "https://github.com/lucasilverentand/lumo-server",
	},
];

type Project = { name: string; desc: string; lang: string; stars?: number; url: string };

const langColor: Record<string, string> = {
	Swift: "#ff453a",
	Rust: "#e05a00",
	TypeScript: "#3b82f6",
	JavaScript: "#eab308",
	Python: "#4b91f7",
};
---

<Layout>
	<main>
		<section class="hero">
			<div class="wrap hero-entrance">
				<div class="hero-row">
					<div class="portrait">
						<DitheredPortrait size={260} />
					</div>
					<div class="hero-text">
						<h1>Luca Silverentand</h1>
						<p class="tagline">
							Self-taught developer with 15+ years of building apps, infrastructure, and everything in between.<br />
							Running <a href="https://github.com/seventwo-studio" target="_blank" rel="noopener">SevenTwo Studio</a> from the Netherlands.
						</p>
						<div class="links">
							<a href="https://github.com/lucasilverentand" target="_blank" rel="noopener" class="link">
								<Icon name="simple-icons:github" size={16} />
								GitHub
							</a>
							<a href="https://threads.net/@luca.silverentand" target="_blank" rel="noopener" class="link">
								<Icon name="simple-icons:threads" size={16} />
								Threads
							</a>
							<a href="https://instagram.com/luca.silverentand" target="_blank" rel="noopener" class="link">
								<Icon name="simple-icons:instagram" size={16} />
								Instagram
							</a>
						</div>
					</div>
				</div>
			</div>
		</section>

		<section class="featured">
			<div class="wrap">
				<div class="featured-card fade-in">
					<div class="featured-header">
						<span class="badge">iOS App</span>
						<span class="tech">Swift &middot; SwiftUI &middot; AirPods Motion</span>
					</div>
					<h2>HeadHigh</h2>
					<p>
						Real-time posture correction using AirPods motion data. Monitors your head
						position and delivers subtle haptic nudges when you slouch &mdash; no extra
						hardware needed.
					</p>
					<div class="featured-links">
						<a href="https://apps.apple.com/app/headhigh/id6748973690" target="_blank" rel="noopener" class="btn-primary">
							<svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M18.71 19.5c-.83 1.24-1.71 2.45-3.05 2.47-1.34.03-1.77-.79-3.29-.79-1.53 0-2 .77-3.27.82-1.31.05-2.3-1.32-3.14-2.53C4.25 17 2.94 12.45 4.7 9.39c.87-1.52 2.43-2.48 4.12-2.51 1.28-.02 2.5.87 3.29.87.78 0 2.26-1.07 3.8-.91.65.03 2.47.26 3.64 1.98-.09.06-2.17 1.28-2.15 3.81.03 3.02 2.65 4.03 2.68 4.04-.03.07-.42 1.44-1.38 2.83M13 3.5c.73-.83 1.94-1.46 2.94-1.5.13 1.17-.34 2.35-1.04 3.19-.69.85-1.83 1.51-2.95 1.42-.15-1.15.41-2.35 1.05-3.11z"/></svg>
							App Store
						</a>
						</div>
				</div>
			</div>
		</section>

		{recentPosts.length > 0 && (
			<section class="writing">
				<div class="wrap">
					<h2>Latest Writing</h2>
					{recentPosts.map((post) => (
						<a
							href={postHref(post)}
							class="post-row fade-in"
							target={post.externalUrl ? "_blank" : undefined}
							rel={post.externalUrl ? "noopener noreferrer" : undefined}
						>
							<div class="post-info">
								<span class="post-title">{post.title}</span>
								<span class="post-desc">
									{post.source ? `${post.source} · ${post.description}` : post.description}
								</span>
							</div>
							<time datetime={post.date.toISOString()}>{formatDate(post.date)}</time>
						</a>
					))}
					<div class="writing-cta fade-in">
						<p class="cta-prose">I write about building products, developer tooling, and lessons from 15+ years of teaching myself to code. From deep dives on Rust and Swift to the messy reality of shipping side projects — no fluff, just things I've actually learned.</p>
						<a href="/blog" class="see-all">
							{remainingCount > 0 ? `Read ${remainingCount} more articles` : "Browse all writing"} &rarr;
						</a>
					</div>
				</div>
			</section>
		)}

		<section class="projects">
			<div class="wrap">
				<h2>Open Source</h2>

				<div class="group">
					<h3>AI Developer Tools</h3>
					<div class="grid">
						{ai.map((p: Project) => (
							<a href={p.url} target="_blank" rel="noopener" class="card fade-in">
								<div class="card-header">
									<span class="name">{p.name}</span>
									{p.stars && (
										<span class="stars">
											<svg width="12" height="12" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
											{p.stars}
										</span>
									)}
								</div>
								<p>{p.desc}</p>
								<span class="lang" style={`--c: ${langColor[p.lang]}`}>
									<span class="dot"></span>{p.lang}
								</span>
							</a>
						))}
					</div>
				</div>

				<div class="group">
					<h3>Developer & Infrastructure</h3>
					<div class="grid">
						{infra.map((p: Project) => (
							<a href={p.url} target="_blank" rel="noopener" class="card fade-in">
								<div class="card-header">
									<span class="name">{p.name}</span>
								</div>
								<p>{p.desc}</p>
								<span class="lang" style={`--c: ${langColor[p.lang]}`}>
									<span class="dot"></span>{p.lang}
								</span>
							</a>
						))}
					</div>
				</div>

				<div class="group">
					<h3>Home & Gaming</h3>
					<div class="grid">
						{misc.map((p: Project) => (
							<a href={p.url} target="_blank" rel="noopener" class="card fade-in">
								<div class="card-header">
									<span class="name">{p.name}</span>
								</div>
								<p>{p.desc}</p>
								<span class="lang" style={`--c: ${langColor[p.lang]}`}>
									<span class="dot"></span>{p.lang}
								</span>
							</a>
						))}
					</div>
				</div>
			</div>
		</section>
	</main>

	<Footer />
</Layout>

<style>
	.wrap {
		max-width: 960px;
		margin: 0 auto;
		padding: 0 24px;
	}



	/* ── Hero ── */
	.hero {
		padding: 120px 0 80px;
	}
	.hero-row {
		display: flex;
		align-items: center;
		gap: 48px;
	}
	.portrait {
		flex-shrink: 0;
	}
	.hero-text {
		min-width: 0;
	}
	.hero h1 {
		font-family: var(--font-display);
		font-size: clamp(48px, 8vw, 88px);
		font-weight: 400;
		line-height: 1;
		letter-spacing: -0.025em;
		margin-bottom: 20px;
	}
	.tagline {
		font-size: 17px;
		line-height: 1.7;
		color: var(--text-2);
		max-width: 520px;
		margin-bottom: 28px;
	}
	.tagline a {
		color: var(--text-1);
		text-decoration: underline;
		text-decoration-color: var(--border-2);
		text-underline-offset: 3px;
		transition: text-decoration-color 0.15s;
	}
	.tagline a:hover { text-decoration-color: var(--text-2); }

	.links { display: flex; gap: 12px; }
	.link {
		display: inline-flex;
		align-items: center;
		gap: 7px;
		font-family: var(--font-mono);
		font-size: 13px;
		color: var(--text-2);
		transition: color 0.15s;
	}
	.link:hover { color: var(--text-1); }

	/* ── Featured ── */
	.featured {
		padding-bottom: 72px;
	}
	.featured-card {
		border: 1px solid var(--border);
		border-radius: 14px;
		padding: 36px 40px;
		background: var(--bg-2);
	}
	.featured-header {
		display: flex;
		align-items: center;
		gap: 12px;
		margin-bottom: 16px;
	}
	.badge {
		font-family: var(--font-mono);
		font-size: 11px;
		font-weight: 500;
		text-transform: uppercase;
		letter-spacing: 0.08em;
		color: var(--accent);
		background: var(--accent-dim);
		padding: 4px 10px;
		border-radius: 6px;
	}
	.tech {
		font-family: var(--font-mono);
		font-size: 12px;
		color: var(--text-3);
	}
	.featured-card h2 {
		font-family: var(--font-display);
		font-size: 40px;
		font-weight: 400;
		line-height: 1.1;
		margin-bottom: 12px;
	}
	.featured-card p {
		font-size: 15px;
		line-height: 1.7;
		color: var(--text-2);
		max-width: 560px;
		margin-bottom: 24px;
	}
	.featured-links {
		display: flex;
		gap: 10px;
	}
	.btn-primary {
		display: inline-flex;
		align-items: center;
		gap: 7px;
		font-family: var(--font-mono);
		font-size: 13px;
		font-weight: 500;
		color: var(--bg);
		background: var(--text-1);
		padding: 9px 18px;
		border-radius: 8px;
		transition: opacity 0.15s;
	}
	.btn-primary:hover { opacity: 0.85; }
	.btn-ghost {
		font-family: var(--font-mono);
		font-size: 13px;
		color: var(--text-2);
		border: 1px solid var(--border-2);
		padding: 9px 18px;
		border-radius: 8px;
		transition: border-color 0.15s, color 0.15s;
	}
	.btn-ghost:hover {
		border-color: var(--text-3);
		color: var(--text-1);
	}

	/* ── Projects ── */
	.projects {
		padding: 64px 0 80px;
		border-top: 1px solid var(--border);
	}
	.projects > .wrap > h2 {
		font-family: var(--font-display);
		font-size: 32px;
		font-weight: 400;
		margin-bottom: 48px;
	}
	.group {
		margin-bottom: 48px;
	}
	.group:last-child { margin-bottom: 0; }
	.group h3 {
		font-family: var(--font-mono);
		font-size: 12px;
		font-weight: 400;
		text-transform: uppercase;
		letter-spacing: 0.08em;
		color: var(--text-3);
		margin-bottom: 16px;
		padding-bottom: 12px;
		border-bottom: 1px solid var(--border);
	}
	.grid {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 10px;
	}
	.card {
		display: flex;
		flex-direction: column;
		border: 1px solid var(--border);
		border-radius: 10px;
		padding: 18px 20px;
		transition: border-color 0.15s, background 0.15s;
	}
	.card:hover {
		border-color: var(--border-2);
		background: var(--bg-2);
	}
	.card-header {
		display: flex;
		align-items: center;
		justify-content: space-between;
		margin-bottom: 6px;
	}
	.name {
		font-family: var(--font-mono);
		font-size: 14px;
		font-weight: 500;
		color: var(--text-1);
	}
	.stars {
		display: flex;
		align-items: center;
		gap: 3px;
		font-family: var(--font-mono);
		font-size: 12px;
		color: var(--text-3);
	}
	.card p {
		font-size: 13px;
		line-height: 1.55;
		color: var(--text-2);
		flex: 1;
		margin-bottom: 14px;
	}
	.lang {
		display: inline-flex;
		align-items: center;
		gap: 6px;
		font-family: var(--font-mono);
		font-size: 11px;
		color: var(--text-3);
	}
	.dot {
		width: 8px;
		height: 8px;
		border-radius: 50%;
		background: var(--c);
	}

	/* ── Writing ── */
	.writing {
		padding-bottom: 72px;
	}
	.writing h2 {
		font-family: var(--font-display);
		font-size: 32px;
		font-weight: 400;
		margin-bottom: 24px;
	}
	.writing-cta {
		margin-top: 40px;
		border: 1px solid var(--border);
		border-radius: 12px;
		padding: 28px 28px 24px;
		text-align: center;
	}
	.cta-prose {
		font-size: 15px;
		line-height: 1.65;
		color: var(--text-2);
		max-width: 540px;
		margin: 0 auto 20px;
	}
	.see-all {
		display: inline-block;
		font-family: var(--font-mono);
		font-size: 14px;
		color: var(--text-1);
		background: var(--bg-2);
		padding: 10px 24px;
		border-radius: 999px;
		transition: opacity 0.15s;
	}
	.see-all:hover {
		opacity: 0.8;
	}
	.post-row {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		gap: 24px;
		padding: 18px 0;
		border-bottom: 1px solid var(--border);
		transition: opacity 0.15s;
	}
	.post-row:first-of-type {
		border-top: 1px solid var(--border);
	}
	.post-row:hover { opacity: 0.75; }
	.post-info {
		display: flex;
		flex-direction: column;
		gap: 4px;
		min-width: 0;
	}
	.post-title {
		font-family: var(--font-mono);
		font-size: 14px;
		font-weight: 500;
		color: var(--text-1);
	}
	.post-desc {
		font-size: 13px;
		color: var(--text-3);
		line-height: 1.5;
		overflow: hidden;
		text-overflow: ellipsis;
		white-space: nowrap;
	}
	.post-row time {
		font-family: var(--font-mono);
		font-size: 12px;
		color: var(--text-3);
		white-space: nowrap;
		flex-shrink: 0;
	}

	/* ── Animations ── */
	@keyframes hero-in {
		from {
			opacity: 0;
			transform: translateY(24px);
		}
		to {
			opacity: 1;
			transform: translateY(0);
		}
	}
	.hero-entrance {
		animation: hero-in 0.8s cubic-bezier(0.16, 1, 0.3, 1) both;
	}
	.hero-entrance h1 {
		animation: hero-in 0.8s cubic-bezier(0.16, 1, 0.3, 1) 0.05s both;
	}
	.hero-entrance .tagline {
		animation: hero-in 0.7s cubic-bezier(0.16, 1, 0.3, 1) 0.15s both;
	}
	.hero-entrance .links {
		animation: hero-in 0.7s cubic-bezier(0.16, 1, 0.3, 1) 0.25s both;
	}

	.fade-in {
		opacity: 0;
		transform: translateY(16px);
		transition: opacity 0.5s cubic-bezier(0.16, 1, 0.3, 1), transform 0.5s cubic-bezier(0.16, 1, 0.3, 1);
	}
	.fade-in.visible {
		opacity: 1;
		transform: translateY(0);
	}

	/* Stagger cards within a grid */
	.grid .fade-in:nth-child(1) { transition-delay: 0s; }
	.grid .fade-in:nth-child(2) { transition-delay: 0.06s; }
	.grid .fade-in:nth-child(3) { transition-delay: 0.12s; }
	.grid .fade-in:nth-child(4) { transition-delay: 0.18s; }
	.grid .fade-in:nth-child(5) { transition-delay: 0.24s; }
	.grid .fade-in:nth-child(6) { transition-delay: 0.30s; }

	/* ── Responsive ── */
	@media (max-width: 768px) {
		.hero { padding: 80px 0 60px; }
		.hero-row {
			flex-direction: column;
			align-items: center;
			gap: 32px;
		}
		.hero-text { text-align: center; }
		.links { justify-content: center; }
		.featured-card { padding: 28px 24px; }
		.grid { grid-template-columns: repeat(2, 1fr); }
		.post-desc { display: none; }
	}
	@media (max-width: 520px) {
		.grid { grid-template-columns: 1fr; }
}
</style>

<script>
	const observer = new IntersectionObserver(
		(entries) => {
			for (const entry of entries) {
				if (entry.isIntersecting) {
					entry.target.classList.add("visible");
					observer.unobserve(entry.target);
				}
			}
		},
		{ threshold: 0.1, rootMargin: "0px 0px -40px 0px" },
	);
	document.querySelectorAll(".fade-in").forEach((el) => observer.observe(el));
</script>
