---
import { getCollection, render } from "astro:content";
import Footer from "../../components/Footer.astro";
import Layout from "../../layouts/Layout.astro";

export async function getStaticPaths() {
	const projects = await getCollection("projects", ({ data }) => !data.draft);
	return projects.map((project) => ({
		params: { slug: project.id },
		props: { project },
	}));
}

const { project } = Astro.props;
const { Content } = await render(project);

function formatDate(date: Date) {
	return date.toLocaleDateString("en-US", { year: "numeric", month: "long" });
}

const links: { label: string; href: string }[] = [];
if (project.data.url) links.push({ label: "Source", href: project.data.url });
if (project.data.homepage && project.data.homepage !== project.data.appStoreUrl) {
	links.push({ label: "Website", href: project.data.homepage });
}
if (project.data.appStoreUrl) links.push({ label: "App Store", href: project.data.appStoreUrl });

const allTags = [
	...project.data.tags.type,
	...project.data.tags.framework,
	...project.data.tags.language,
];
---

<Layout
	title={`${project.data.name} — Luca Silverentand`}
	description={project.data.description}
>
	<main>
		<article>
			<div class="max-w-[720px] mx-auto px-6">
				<a
					href="/#projects"
					class="inline-block font-mono text-[13px] text-text-faint mt-12 mb-10 transition-colors duration-150 hover:text-text-primary"
					>&larr; Back to projects</a
				>

				<header class="mb-12">
					<div class="flex items-center flex-wrap gap-y-2 mb-4.5 min-h-3.5">
						<span
							class="font-mono text-[13px] text-text-faint leading-none inline-flex items-center"
						>
							{project.data.owner}
						</span>
						<span
							class="font-mono text-[13px] text-text-faint leading-none inline-flex items-center justify-center mx-3"
							>&middot;</span
						>
						<time
							datetime={project.data.date.toISOString()}
							class="font-mono text-[13px] text-text-faint leading-none inline-flex items-center"
							>{formatDate(project.data.date)}</time
						>
					</div>
					<h1
						class="font-display text-[clamp(32px,5vw,48px)] font-normal leading-tight tracking-tight mb-4"
					>
						{project.data.name}
					</h1>
					<p class="text-[17px] leading-relaxed text-text-muted">
						{project.data.description}
					</p>
					{
						allTags.length > 0 && (
							<div class="flex flex-wrap gap-2 mt-4.5">
								{allTags.map((tag) => (
									<span class="font-mono text-[11px] text-text-muted bg-surface-raised border border-border-subtle px-2.5 py-1 rounded-full leading-tight break-all">
										{tag}
									</span>
								))}
							</div>
						)
					}
					{
						links.length > 0 && (
							<div class="flex flex-wrap gap-4 mt-6">
								{links.map((link) => (
									<a
										href={link.href}
										target="_blank"
										rel="noopener noreferrer"
										class="font-mono text-[13px] text-text-primary no-underline border-b border-border-strong pb-0.5 hover:border-text-muted"
									>
										{link.label} &rarr;
									</a>
								))}
							</div>
						)
					}
				</header>

				<div class="prose pb-20">
					<Content />
				</div>
			</div>
		</article>
	</main>

	<Footer />
</Layout>
